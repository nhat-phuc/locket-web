        >
          <img src="/img/logo/logo.jpg" alt="Hỗ trợ" style={{ width: "100%", height: "100%", borderRadius: "50%", objectFit: "contain" }} />
          <span style={{ position: "absolute", bottom: -6, left: "50%", transform: "translateX(-50%)", background: "#ef4444", color: "#fff", fontSize: 10, fontWeight: 700, padding: "2px 6px", borderRadius: 10, whiteSpace: "nowrap", animation: "blink-badge 1.5s infinite" }}>Liên hệ</span>
        </a>
      </div>
    </>
  );
}

/* ═══════════════════════════════════════════
   MAIN COMPONENT
   ═══════════════════════════════════════════ */
export default function TrangChuPage() {
  const [displayedCount, setDisplayedCount] = useState(12);
  const [reviewShown, setReviewShown] = useState(16);
  const [faqOpen, setFaqOpen] = useState<number | null>(null);
  const [lightboxImg, setLightboxImg] = useState<string | null>(null);
  const [catLoaderVisible, setCatLoaderVisible] = useState(true);
  const [noticeVisible, setNoticeVisible] = useState(false);
  const [backToTopVisible, setBackToTopVisible] = useState(false);

  const canvasRef = useRef<HTMLCanvasElement>(null);
  const iconMapRef = useRef<HTMLDivElement>(null);

  /* Cat loader */
  useEffect(() => {
    const t = setTimeout(() => setCatLoaderVisible(false), 2500);
    return () => clearTimeout(t);
  }, []);

  /* Notice modal */
  useEffect(() => {
    const hideUntil = localStorage.getItem("notice_hidden_until");
    if (!hideUntil || Date.now() > parseInt(hideUntil)) {
      const t = setTimeout(() => setNoticeVisible(true), 700);
      return () => clearTimeout(t);
    }
  }, []);

  /* Back to top */
  useEffect(() => {
    const onScroll = () => setBackToTopVisible(window.scrollY > 400);
    window.addEventListener("scroll", onScroll, { passive: true });
    return () => window.removeEventListener("scroll", onScroll);
  }, []);

  /* Falling canvas */
  useEffect(() => {
    const canvas = canvasRef.current;
    if (!canvas) return;
    const ctx = canvas.getContext("2d");
    if (!ctx) return;
    let W = window.innerWidth, H = window.innerHeight;
    canvas.width = W; canvas.height = H;
    const heartImg = new Image();
    heartImg.src = "/img/logo/icon.jpg";
    const MAX_P = 14;
    const mkParticle = () => ({
      x: Math.random() * W, y: -20,
      size: 10 + Math.random() * 14,
      speed: 0.3 + Math.random() * 0.5,
      drift: (Math.random() - 0.5) * 0.4,
      rot: Math.random() * Math.PI * 2,
      rotSpd: (Math.random() - 0.5) * 0.03,
      alpha: 0.35 + Math.random() * 0.35,
      sway: Math.random() * Math.PI * 2,
      swaySpd: 0.008 + Math.random() * 0.015,
    });
    const particles = Array.from({ length: MAX_P }, () => {
      const p = mkParticle(); p.y = Math.random() * H; return p;
    });
    let rafId: number;
    const anim = () => {
      ctx.clearRect(0, 0, W, H);
      particles.forEach((pt, i) => {
        pt.sway += pt.swaySpd;
        pt.x += Math.sin(pt.sway) * 0.6 + pt.drift;
        pt.y += pt.speed;
        pt.rot += pt.rotSpd;
        ctx.save();
        ctx.globalAlpha = pt.alpha;
        ctx.translate(pt.x, pt.y);
        ctx.rotate(pt.rot);
        if (heartImg.complete && heartImg.naturalWidth > 0)
          ctx.drawImage(heartImg, -pt.size / 2, -pt.size / 2, pt.size, pt.size);
        ctx.restore();
        if (pt.y > H + 20) particles[i] = mkParticle();
      });
      rafId = requestAnimationFrame(anim);
    };
    anim();
    const onResize = () => {
      W = window.innerWidth; H = window.innerHeight;
      canvas.width = W; canvas.height = H;
    };
    window.addEventListener("resize", onResize);
    return () => { cancelAnimationFrame(rafId); window.removeEventListener("resize", onResize); };
  }, []);

  /* Icon map physics */
  useEffect(() => {
    const contentEl = iconMapRef.current;
    if (!contentEl) return;

    let containerWidth = contentEl.clientWidth;
    let containerHeight = contentEl.clientHeight;

    const centerNode = contentEl.querySelector(".center-app-node") as HTMLElement | null;
    let centerObj = centerNode ? {
      x: containerWidth / 2,
      y: containerHeight / 2,
      r: (centerNode.offsetWidth / 2) + 6,
    } : null;

    interface Node {
      el: HTMLElement;
      innerEl: HTMLElement | null;
      x: number; y: number;
      vx: number; vy: number;
      r: number;
      frozen: boolean;
    }

    const nodes: Node[] = [];
    const nodeEls = contentEl.querySelectorAll<HTMLElement>(".floating-icon-node");

    nodeEls.forEach((el) => {
      const isMobile = window.innerWidth <= 768;
      const startX = parseFloat(el.getAttribute(isMobile ? "data-x-mb" : "data-x-dt") || "50");
      const startY = parseFloat(el.getAttribute(isMobile ? "data-y-mb" : "data-y-dt") || "50");
      const x = (startX / 100) * containerWidth;
      const y = (startY / 100) * containerHeight;
      const r = el.offsetWidth / 2;
      const angle = Math.random() * Math.PI * 2;
      const speed = 0.4 + Math.random() * 0.6;
      const node: Node = {
        el,
        innerEl: el.querySelector(".floating-icon-inner"),
        x, y,
        vx: Math.cos(angle) * speed,
        vy: Math.sin(angle) * speed,
        r,
        frozen: false,
      };
      nodes.push(node);
      el.addEventListener("click", (e) => {
        e.stopPropagation();
        if (!node.frozen) {
          node.frozen = true;
          node.vx = 0; node.vy = 0;
          node.innerEl?.classList.add("frozen");
        } else {
          node.frozen = false;
          const a = Math.random() * Math.PI * 2;
          const s = 0.4 + Math.random() * 0.6;
          node.vx = Math.cos(a) * s;
          node.vy = Math.sin(a) * s;
          node.innerEl?.classList.remove("frozen");
        }
      });
    });

    contentEl.style.opacity = "1";

    let rafId: number;
    const update = () => {
      for (const n of nodes) {
        if (n.frozen) continue;
        n.x += n.vx; n.y += n.vy;
        if (n.x - n.r < 0) { n.x = n.r; n.vx = -n.vx; }
        else if (n.x + n.r > containerWidth) { n.x = containerWidth - n.r; n.vx = -n.vx; }
        if (n.y - n.r < 0) { n.y = n.r; n.vy = -n.vy; }
        else if (n.y + n.r > containerHeight) { n.y = containerHeight - n.r; n.vy = -n.vy; }
        if (centerObj) {
          const dx = n.x - centerObj.x;
          const dy = n.y - centerObj.y;
          const dist = Math.sqrt(dx * dx + dy * dy);
          const minDist = n.r + centerObj.r;
          if (dist < minDist) {
            const nx = dx / (dist || 0.1);
            const ny = dy / (dist || 0.1);
            n.x = centerObj.x + nx * minDist;
            const dot = n.vx * nx + n.vy * ny;
            n.vx = n.vx - 2 * dot * nx;
            n.vy = n.vy - 2 * dot * ny;
          }
        }
      }
      nodes.forEach((n) => {
        n.el.style.transform = `translate3d(${n.x - n.r}px, ${n.y - n.r}px, 0)`;
      });
      rafId = requestAnimationFrame(update);
    };
    update();
    return () => cancelAnimationFrame(rafId);
  }, []);

  const txExpand = () => setDisplayedCount((c) => Math.min(c + 8, depositData.length));
  const txCollapse = () => setDisplayedCount(12);
  const reviewExpand = () => setReviewShown((c) => Math.min(c + 16, reviews.length));
  const reviewCollapse = () => setReviewShown(16);
  const closeNotice = () => setNoticeVisible(false);
  const closeNotice24h = () => {
    closeNotice();
    localStorage.setItem("notice_hidden_until", String(Date.now() + 24 * 60 * 60 * 1000));
  };

  const displayDeposits = depositData.slice(0, displayedCount);
  const displayReviews = reviews.slice(0, reviewShown);

  return (
    <>
      <Header />

      <canvas ref={canvasRef} style={{ position: "fixed", inset: 0, pointerEvents: "none", zIndex: 1, opacity: 0.4 }} />

      {/* Cat loader */}
      {catLoaderVisible && (
        <div style={{ position: "fixed", inset: 0, zIndex: 999999, background: "#0d0d18", display: "flex", flexDirection: "column", alignItems: "center", justifyContent: "center", gap: 20 }}>
          <div style={{ width: 120, height: 120, position: "relative" }}>
            <div style={{ position: "absolute", inset: 0, borderRadius: "50%", border: "3px solid transparent", borderTopColor: "#a78bfa", borderRightColor: "#f472b6", animation: "spin-wheel 1s linear infinite" }} />
            <img src="/img/logo/logo.jpg" alt="Loading" style={{ position: "absolute", inset: 20, width: "calc(100% - 40px)", height: "calc(100% - 40px)", objectFit: "contain", borderRadius: "50%" }} />
          </div>
          <div style={{ fontSize: 14, color: "#a78bfa", letterSpacing: 2, fontWeight: 700 }}>Đang tải Locket Gold...</div>
        </div>
      )}

      <main className="wrap center-y" style={{ paddingTop: 32, paddingBottom: 60 }}>
        <div className="page-shell" style={{ textAlign: "center" }}>

          {/* HERO */}
          <div style={{ display: "flex", alignItems: "center", justifyContent: "space-between", gap: 60, marginBottom: 60, flexWrap: "wrap", textAlign: "left" }}>
            <div style={{ flex: 1.25, minWidth: 340 }}>
              <h1 style={{ fontSize: "clamp(34px,5.5vw,64px)", fontWeight: 900, lineHeight: 1.15, letterSpacing: -1, color: "var(--text-0)", marginBottom: 20 }}>
                Hệ Thống Nâng Cấp<br />
                <span style={{ background: "linear-gradient(270deg, #A78BFA, #F472B6, #8B5CF6, #3B82F6, #A78BFA)", backgroundSize: "400% 400%", WebkitBackgroundClip: "text", backgroundClip: "text", WebkitTextFillColor: "transparent", animation: "gradient-shift 6s ease infinite", display: "inline-block" }}>
                  LocketGold Tự Động
                </span>
              </h1>
              <div style={{ background: "linear-gradient(to right, rgba(167,139,250,0.1), transparent)", borderLeft: "4px solid var(--accent)", padding: "18px 20px", borderRadius: "0 12px 12px 0", marginBottom: 28, fontSize: 15, lineHeight: 1.6, color: "var(--text-0)" }}>

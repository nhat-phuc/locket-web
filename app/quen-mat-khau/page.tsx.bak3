"use client";

import Link from "next/link";
import { useRouter } from "next/navigation";
import { useState } from "react";

type RecoveryType = "email" | "phone" | "username";
type Step = "input" | "otp" | "password" | "done";

export default function QuenMatKhauPage() {
  const router = useRouter();
  const [step, setStep] = useState<Step>("input");
  const [type, setType] = useState<RecoveryType>("email");
  const [inputValue, setInputValue] = useState("");
  const [maskedEmail, setMaskedEmail] = useState("");
  const [otp, setOtp] = useState("");
  const [newPassword, setNewPassword] = useState("");
  const [confirmPassword, setConfirmPassword] = useState("");
  const [resetToken, setResetToken] = useState("");
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState("");
  const [countdown, setCountdown] = useState(0);

  const placeholderMap = {
    email: "your@email.com",
    phone: "0912345678",
    username: "username",
  };

  const labelMap = {
    email: "Email đã đăng ký",
    phone: "Số điện thoại",
    username: "Username",
  };

  const handleSendOtp = async (e: React.FormEvent) => {
    e.preventDefault();
    setError("");
    setLoading(true);

    try {
      const lookupRes = await fetch("/api/auth/lookup", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ type, value: inputValue.trim() }),
      });
      const lookupData = await lookupRes.json();

      if (!lookupData.success) {
        setError(lookupData.message || "Không tìm thấy tài khoản");
        setLoading(false);
        return;
      }

      setMaskedEmail(lookupData.maskedEmail);

      const sendRes = await fetch("/api/auth/send-otp", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          email: type === "email" ? inputValue.trim() : undefined,
          phone: type === "phone" ? inputValue.trim() : undefined,
          username: type === "username" ? inputValue.trim() : undefined,
        }),
      });
      const sendData = await sendRes.json();

      if (sendData.success) {
        setStep("otp");
        setCountdown(60);
        const timer = setInterval(() => {
          setCountdown((c) => {
            if (c <= 1) { clearInterval(timer); return 0; }
            return c - 1;
          });
        }, 1000);
      } else {
        setError(sendData.message || "Lỗi gửi OTP");
      }
    } catch {
      setError("Lỗi kết nối");
    } finally {
      setLoading(false);
    }
  };

  const handleVerifyOtp = async (e: React.FormEvent) => {
    e.preventDefault();
    setError("");
    setLoading(true);

    try {
      const res = await fetch("/api/auth/verify-otp", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          email: type === "email" ? inputValue.trim() : undefined,
          phone: type === "phone" ? inputValue.trim() : undefined,
          username: type === "username" ? inputValue.trim() : undefined,
          otp,
        }),
      });
      const data = await res.json();

      if (data.success && data.resetToken) {
        setResetToken(data.resetToken);
        setStep("password");
      } else {
        setError(data.message || "OTP không đúng");
      }
    } catch {
      setError("Lỗi kết nối");
    } finally {
      setLoading(false);
    }
  };

  const handleResetPassword = async (e: React.FormEvent) => {
    e.preventDefault();
    setError("");

    if (newPassword !== confirmPassword) { setError("Mật khẩu xác nhận không khớp"); return; }
    if (newPassword.length < 6) { setError("Mật khẩu phải có ít nhất 6 ký tự"); return; }

    setLoading(true);
    try {
      const res = await fetch("/api/auth/reset-password", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ resetToken, newPassword }),
      });
      const data = await res.json();

      if (data.success) {
        setStep("done");
        setTimeout(() => router.push("/dang-nhap"), 2500);
      } else {
        setError(data.message || "Lỗi đổi mật khẩu");
      }
    } catch {
      setError("Lỗi kết nối");
    } finally {
      setLoading(false);
    }
  };

  const handleResendOtp = async () => {
    if (countdown > 0) return;
    setLoading(true);
    try {
      await fetch("/api/auth/send-otp", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          email: type === "email" ? inputValue.trim() : undefined,
          phone: type === "phone" ? inputValue.trim() : undefined,
          username: type === "username" ? inputValue.trim() : undefined,
        }),
      });
      setCountdown(60);
      const timer = setInterval(() => {
        setCountdown((c) => {
          if (c <= 1) { clearInterval(timer); return 0; }
          return c - 1;
        });
      }, 1000);
    } catch {}
    setLoading(false);
  };

  return (
    <>
      <style>{`
        .qmk-wrap {
          min-height: 100vh;
          padding: 80px 16px 60px;
          display: flex;
          align-items: center;
          justify-content: center;
          background: var(--bg-0);
        }
        .qmk-card {
          width: 100%;
          max-width: 440px;
          background: var(--bg-1);
          border: 1.5px solid rgba(167, 139, 250, 0.2);
          border-radius: 20px;
          padding: 28px 24px;
          box-shadow: 0 20px 60px rgba(0, 0, 0, 0.06);
          box-sizing: border-box;
        }
        .qmk-title {
          font-size: 24px;
          font-weight: 900;
          text-align: center;
          background: linear-gradient(135deg, #a78bfa, #7c3aed);
          -webkit-background-clip: text;
          background-clip: text;
          -webkit-text-fill-color: transparent;
          margin: 0 0 6px;
        }
        .qmk-sub {
          font-size: 13.5px;
          color: var(--text-2);
          text-align: center;
          margin: 0 0 20px;
        }
        .qmk-tabs {
          display: flex;
          gap: 4px;
          padding: 4px;
          background: var(--bg-2);
          border-radius: 12px;
          margin-bottom: 18px;
        }
        .qmk-tab {
          flex: 1;
          padding: 9px 6px;
          border-radius: 9px;
          border: none;
          background: transparent;
          color: var(--text-2);
          font-size: 12.5px;
          font-weight: 800;
          font-family: inherit;
          cursor: pointer;
          transition: all 0.2s;
          white-space: nowrap;
        }
        .qmk-tab.is-on {
          background: linear-gradient(135deg, #a78bfa, #7c3aed);
          color: #fff;
          box-shadow: 0 4px 12px rgba(124, 58, 237, 0.3);
        }
        .qmk-label {
          display: block;
          font-size: 13.5px;
          font-weight: 700;
          color: var(--text-0);
          margin-bottom: 8px;
        }
        .qmk-input {
          width: 100%;
          padding: 12px 14px;
          background: var(--bg-2);
          border: 1.5px solid var(--border);
          border-radius: 12px;
          font-size: 15px;
          font-family: inherit;
          color: var(--text-0);
          outline: none;
          transition: all 0.2s;
          box-sizing: border-box;
        }
        .qmk-input:focus {
          border-color: #a78bfa;
          background: var(--bg-1);
          box-shadow: 0 0 0 4px rgba(167, 139, 250, 0.15);
        }
        .qmk-input-otp {
          font-size: 22px;
          font-weight: 900;
          text-align: center;
          letter-spacing: 8px;
          font-family: ui-monospace, monospace;
          padding: 14px;
        }
        .qmk-btn {
          width: 100%;
          padding: 14px;
          background: linear-gradient(135deg, #a78bfa, #7c3aed);
          color: #fff;
          border: none;
          border-radius: 12px;
          font-size: 15px;
          font-weight: 800;
          font-family: inherit;
          cursor: pointer;
          transition: all 0.25s;
          box-shadow: 0 8px 24px rgba(124, 58, 237, 0.3);
          box-sizing: border-box;
        }
        .qmk-btn:hover:not(:disabled) {
          transform: translateY(-2px);
          box-shadow: 0 12px 32px rgba(124, 58, 237, 0.4);
        }
        .qmk-btn:disabled {
          opacity: 0.55;
          cursor: not-allowed;
        }
        .qmk-error {
          padding: 11px 14px;
          background: rgba(239, 68, 68, 0.08);
          border: 1px solid rgba(239, 68, 68, 0.3);
          border-radius: 10px;
          color: #dc2626;
          font-size: 13px;
          font-weight: 600;
          margin-bottom: 14px;
        }
        .qmk-info {
          padding: 11px 14px;
          background: rgba(167, 139, 250, 0.08);
          border: 1px solid rgba(167, 139, 250, 0.2);
          border-radius: 10px;
          font-size: 12.5px;
          color: var(--text-2);
          text-align: center;
          margin-top: 16px;
        }
        .qmk-footer {
          text-align: center;
          margin-top: 18px;
          font-size: 13.5px;
          color: var(--text-2);
        }
        .qmk-link {
          color: #a78bfa;
          font-weight: 700;
          text-decoration: none;
        }
        .qmk-link:hover { color: #7c3aed; text-decoration: underline; }
        .qmk-field { margin-bottom: 14px; }
        .qmk-help {
          font-size: 12px;
          color: var(--text-2);
          margin-top: 6px;
        }
        .qmk-masked {
          color: #7c3aed;
          font-family: ui-monospace, monospace;
          font-weight: 800;
        }
        .qmk-success-icon {
          font-size: 60px;
          margin-bottom: 12px;
          text-align: center;
        }
        .qmk-success-title {
          font-size: 20px;
          font-weight: 900;
          color: #10b981;
          text-align: center;
          margin-bottom: 10px;
        }
        .qmk-success-desc {
          font-size: 13.5px;
          color: var(--text-2);
          text-align: center;
          margin-bottom: 18px;
        }
        @media (max-width: 480px) {
          .qmk-wrap { padding: 60px 12px 40px; }
          .qmk-card { padding: 22px 18px; border-radius: 16px; }
          .qmk-title { font-size: 22px; }
          .qmk-tab { font-size: 11.5px; padding: 8px 4px; }
          .qmk-input { font-size: 14.5px; padding: 11px 12px; }
          .qmk-input-otp { font-size: 20px; }
          .qmk-btn { font-size: 14.5px; padding: 13px; }
        }
      `}</style>

      <div className="qmk-wrap">
        <div className="qmk-card">
          {/* STEP 1 */}
          {step === "input" && (
            <>
              <h1 className="qmk-title">Quên Mật Khẩu</h1>
              <p className="qmk-sub">Chọn cách khôi phục tài khoản</p>

              <div className="qmk-tabs">
                {(["email", "phone", "username"] as RecoveryType[]).map((t) => (
                  <button
                    key={t}
                    type="button"
                    className={`qmk-tab${type === t ? " is-on" : ""}`}
                    onClick={() => { setType(t); setInputValue(""); setError(""); }}
                  >
                    {t === "email" ? "📧 Email" : t === "phone" ? "📱 SĐT" : "👤 Username"}
                  </button>
                ))}
              </div>

              {error && <div className="qmk-error">{error}</div>}

              <form onSubmit={handleSendOtp}>
                <div className="qmk-field">
                  <label className="qmk-label">
                    {labelMap[type]} <span style={{ color: "#ef4444" }}>*</span>
                  </label>
                  <input
                    type={type === "email" ? "email" : "text"}
                    className="qmk-input"
                    value={inputValue}
                    onChange={(e) => setInputValue(e.target.value)}
                    placeholder={placeholderMap[type]}
                    required
                    autoComplete="off"
                  />
                  <div className="qmk-help">
                    {type === "email" && "Nhập email bạn đã đăng ký"}
                    {type === "phone" && "Nhập SĐT 10 số bạn đã đăng ký"}
                    {type === "username" && "Nhập username của bạn"}
                  </div>
                </div>

                <button
                  type="submit"
                  className="qmk-btn"
                  disabled={loading || !inputValue}
                >
                  {loading ? "Đang tìm..." : "🔍 Tìm tài khoản"}
                </button>
              </form>

              <div className="qmk-info">
                💡 Không nhớ gì cả?{" "}
                <a href="https://zalo.me/0344421026" target="_blank" rel="noopener noreferrer" className="qmk-link">
                  Liên hệ admin
                </a>
              </div>
            </>
          )}

          {/* STEP 2 */}
          {step === "otp" && (
            <>
              <h1 className="qmk-title">Nhập Mã OTP</h1>
              <p className="qmk-sub">
                Mã 6 số đã gửi tới email:
                <br />
                <span className="qmk-masked">{maskedEmail}</span>
              </p>

              {error && <div className="qmk-error">{error}</div>}

              <form onSubmit={handleVerifyOtp}>
                <div className="qmk-field">
                  <label className="qmk-label">
                    Mã OTP <span style={{ color: "#ef4444" }}>*</span>
                  </label>
                  <input
                    type="text"
                    className="qmk-input qmk-input-otp"
                    value={otp}
                    onChange={(e) => setOtp(e.target.value.replace(/\D/g, "").slice(0, 6))}
                    placeholder="000000"
                    required
                    maxLength={6}
                    inputMode="numeric"
                    autoFocus
                  />
                </div>

                <button
                  type="submit"
                  className="qmk-btn"
                  disabled={loading || otp.length !== 6}
                >
                  {loading ? "Đang xác thực..." : "✓ Xác nhận OTP"}
                </button>
              </form>

              <div className="qmk-footer">
                Không nhận được mã?{" "}
                <button
                  type="button"
                  onClick={handleResendOtp}
                  disabled={countdown > 0 || loading}
                  style={{
                    background: "transparent",
                    border: "none",
                    color: countdown > 0 ? "#9ca3af" : "#a78bfa",
                    fontWeight: 700,
                    cursor: countdown > 0 ? "not-allowed" : "pointer",
                    fontSize: 13.5,
                    fontFamily: "inherit",
                    padding: 0,
                  }}
                >
                  {countdown > 0 ? `Gửi lại sau ${countdown}s` : "Gửi lại OTP"}
                </button>
              </div>

              <div className="qmk-info">
                📧 Không thấy email? Kiểm tra <b>Spam</b> / <b>Quảng cáo</b>
              </div>
            </>
          )}

          {/* STEP 3 */}
          {step === "password" && (
            <>
              <h1 className="qmk-title">Đặt Mật Khẩu Mới</h1>
              <p className="qmk-sub">Mật khẩu mới cần tối thiểu 6 ký tự</p>

              {error && <div className="qmk-error">{error}</div>}

              <form onSubmit={handleResetPassword}>
                <div className="qmk-field">
                  <label className="qmk-label">
                    Mật khẩu mới <span style={{ color: "#ef4444" }}>*</span>
                  </label>
                  <input
                    type="password"
                    className="qmk-input"
                    value={newPassword}
                    onChange={(e) => setNewPassword(e.target.value)}
                    placeholder="••••••••"
                    required
                    minLength={6}
                    autoFocus
                  />
                </div>

                <div className="qmk-field">
                  <label className="qmk-label">
                    Xác nhận mật khẩu <span style={{ color: "#ef4444" }}>*</span>
                  </label>
                  <input
                    type="password"
                    className="qmk-input"
                    value={confirmPassword}
                    onChange={(e) => setConfirmPassword(e.target.value)}
                    placeholder="••••••••"
                    required
                    minLength={6}
                  />
                </div>

                <button
                  type="submit"
                  className="qmk-btn"
                  disabled={loading || !newPassword || !confirmPassword}
                >
                  {loading ? "Đang xử lý..." : "🔐 Đổi mật khẩu"}
                </button>
              </form>
            </>
          )}

          {/* STEP 4 */}
          {step === "done" && (
            <>
              <div className="qmk-success-icon">✅</div>
              <h2 className="qmk-success-title">Đổi mật khẩu thành công!</h2>
              <p className="qmk-success-desc">Đang chuyển về trang đăng nhập...</p>
              <Link href="/dang-nhap" className="qmk-link">
                → Đăng nhập ngay
              </Link>
            </>
          )}

          {step !== "done" && (
            <p className="qmk-footer">
              <Link href="/dang-nhap" className="qmk-link">
                ← Quay lại đăng nhập
              </Link>
            </p>
          )}
        </div>
      </div>
    </>
  );
}

"use client";

import { useEffect, useState } from "react";
import { useRouter } from "next/navigation";

interface HistoryItem {
  id: string;
  amount: number;
  status: string;
  createdAt: string;
}

interface OrderInfo {
  orderId: string;
  orderCode: string;
  amount: number;
  qrUrl: string;
  bank: string;
  accountNumber: string;
  accountName: string;
  expiresAt: string;
}

const QUICK_AMOUNTS = [20000, 50000, 100000, 200000, 500000, 1000000];
const MIN_AMOUNT = 10000;

export default function NapTienPage() {
  const router = useRouter();

  const [user, setUser] = useState<{ id: string; email: string; username?: string } | null>(null);
  const [balance, setBalance] = useState(0);
  const [step, setStep] = useState<"input" | "qr">("input");
  const [tab, setTab] = useState<"package" | "custom">("package");
  const [amount, setAmount] = useState("");
  const [order, setOrder] = useState<OrderInfo | null>(null);
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState("");
  const [copied, setCopied] = useState<string | null>(null);
  const [timeLeft, setTimeLeft] = useState(15 * 60);
  const [paid, setPaid] = useState(false);
  const [history, setHistory] = useState<HistoryItem[]>([]);

  useEffect(() => {
    const stored = sessionStorage.getItem("locket_user");
    if (!stored) {
      router.push("/dang-nhap");
      return;
    }
    try {
      const u = JSON.parse(stored);
      setUser(u);
      if (u.email) {
        fetch(`/api/balance?email=${encodeURIComponent(u.email)}`)
          .then((r) => r.json())
          .then((d) => { if (typeof d.balance === "number") setBalance(d.balance); })
          .catch(() => {});

        fetch(`/api/users/transactions`)
          .then((r) => r.json())
          .then((d) => {
            if (d.success && Array.isArray(d.transactions)) {
              const recharges = d.transactions
                .filter((t: { type: string }) => t.type === "recharge")
                .slice(0, 5);
              setHistory(recharges);
            }
          })
          .catch(() => {});
      }
    } catch {}
  }, [router]);

  useEffect(() => {
    if (step !== "qr" || timeLeft <= 0 || paid) return;
    const t = setInterval(() => setTimeLeft((v) => Math.max(0, v - 1)), 1000);
    return () => clearInterval(t);
  }, [step, timeLeft, paid]);

  useEffect(() => {
    if (step !== "qr" || !order || paid) return;

    const checkStatus = async () => {
      try {
        const res = await fetch(`/api/recharge/check?orderId=${order.orderId}`, { cache: "no-store" });
        const data = await res.json();
        if (data.success && (data.status === "paid" || data.status === "success")) {
          setPaid(true);
          if (user?.email) {
            fetch(`/api/balance?email=${encodeURIComponent(user.email)}`)
              .then((r) => r.json())
              .then((d) => { if (typeof d.balance === "number") setBalance(d.balance); })
              .catch(() => {});
          }
          setTimeout(() => router.push("/tai-khoan"), 3500);
        }
      } catch {}
    };

    checkStatus();
    const interval = setInterval(checkStatus, 3000);
    return () => clearInterval(interval);
  }, [step, order, paid, user?.email, router]);

  const selectAmount = (v: number) => setAmount(String(v));

  const handleCreateOrder = async () => {
    const amt = Number(amount);
    if (!amt || amt < MIN_AMOUNT) {
      setError(`Số tiền tối thiểu ${MIN_AMOUNT.toLocaleString("vi-VN")}đ`);
      return;
    }

    setLoading(true);
    setError("");

    try {
      const code = `NPT${Date.now().toString(36).toUpperCase()}`;
      const res = await fetch("/api/recharge/create", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          email: user?.email,
          username: user?.username,
          amount: amt,
          content: code,
          orderCode: code,
        }),
      });
      const data = await res.json();
      if (!data.success) {
        setError(data.message || "Không thể tạo đơn nạp");
        return;
      }

      const orderId = data.orderId || data.order?.id;
      const detailRes = await fetch("/api/payments/create", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ orderId, paymentMethod: "bank_transfer" }),
      });
      const detail = await detailRes.json();
      if (detail.success) {
        setOrder({
          orderId,
          orderCode: detail.orderCode,
          amount: detail.amount,
          qrUrl: detail.qrUrl,
          bank: detail.bank,
          accountNumber: detail.accountNumber,
          accountName: detail.accountName,
          expiresAt: detail.expiresAt,
        });
        const expires = new Date(detail.expiresAt).getTime();
        setTimeLeft(Math.max(0, Math.floor((expires - Date.now()) / 1000)));
        setStep("qr");
      } else {
        setError(detail.message || "Không tạo được QR");
      }
    } catch {
      setError("Lỗi kết nối");
    } finally {
      setLoading(false);
    }
  };

  const copy = (text: string, key: string) => {
    navigator.clipboard.writeText(text);
    setCopied(key);
    setTimeout(() => setCopied(null), 1500);
  };

  if (!user) return null;

  const mm = String(Math.floor(timeLeft / 60)).padStart(2, "0");
  const ss = String(timeLeft % 60).padStart(2, "0");
  const selectedAmount = Number(amount) || 0;

  return (
    <main className="nt-page">
      <div className="nt-orb nt-orb-1" />
      <div className="nt-orb nt-orb-2" />

      <div className="nt-wrap">
        {/* Hero */}
        <div className="nt-hero">
          <div className="nt-badge">
            <span className="nt-badge-dot" />
            {step === "input" ? "Nạp tiền tự động" : "Đang chờ thanh toán"}
          </div>
          <h1 className="nt-h1">
            Nạp Tiền Vào <span className="nt-grad">Ví Locket Gold</span>
          </h1>
          <p className="nt-sub">
            Nạp nhanh qua VietQR — Tiền vào ví tự động trong vài giây
          </p>

          <div className="nt-balance-card">
            <div className="nt-balance-label">SỐ DƯ HIỆN TẠI</div>
            <div className="nt-balance-value">{balance.toLocaleString("vi-VN")}đ</div>
          </div>
        </div>

        {error && <div className="nt-error">{error}</div>}

        {/* STEP 1 */}
        {step === "input" && (
          <div className="nt-card">
            {/* Tabs */}
            <div className="nt-tabs">
              <button
                type="button"
                className={`nt-tab ${tab === "package" ? "is-on" : ""}`}
                onClick={() => { setTab("package"); setAmount(""); }}
              >
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.5" strokeLinecap="round" strokeLinejoin="round">
                  <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z" />
                </svg>
                Chọn gói
              </button>
              <button
                type="button"
                className={`nt-tab ${tab === "custom" ? "is-on" : ""}`}
                onClick={() => { setTab("custom"); setAmount(""); }}
              >
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.5" strokeLinecap="round" strokeLinejoin="round">
                  <line x1="12" y1="1" x2="12" y2="23" />
                  <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" />
                </svg>
                Nạp tùy ý
              </button>
            </div>

            <div className="nt-card-head">
              <div className="nt-card-icon">
                {tab === "package" ? (
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.5" strokeLinecap="round" strokeLinejoin="round">
                    <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z" />
                  </svg>
                ) : (
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.5" strokeLinecap="round" strokeLinejoin="round">
                    <line x1="12" y1="1" x2="12" y2="23" />
                    <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" />
                  </svg>
                )}
              </div>
              <div>
                <div className="nt-card-title">
                  {tab === "package" ? "Chọn gói nạp tiền" : "Nhập số tiền muốn nạp"}
                </div>
                <div className="nt-card-sub">
                  {tab === "package" ? "Chọn 1 trong các gói có sẵn" : "Nhập số tiền tùy ý (tối thiểu 10.000đ)"}
                </div>
              </div>
            </div>

            {/* TAB PACKAGE */}
            {tab === "package" && (
              <>
                <div className="nt-quick">
                  {QUICK_AMOUNTS.map((v) => (
                    <button
                      key={v}
                      type="button"
                      onClick={() => selectAmount(v)}
                      className={`nt-chip ${selectedAmount === v ? "is-on" : ""}`}
                    >
                      {v.toLocaleString("vi-VN")}đ
                    </button>
                  ))}
                </div>
              </>
            )}

            {/* TAB CUSTOM */}
            {tab === "custom" && (
              <div className="nt-input-wrap">
                <input
                  type="text"
                  value={amount ? Number(amount).toLocaleString("vi-VN") : ""}
                  onChange={(e) => {
                    const v = e.target.value.replace(/\D/g, "");
                    setAmount(v);
                  }}
                  placeholder="Nhập số tiền..."
                  className="nt-input"
                  autoFocus
                />
                <span className="nt-input-suffix">VNĐ</span>
              </div>
            )}

            <button
              onClick={handleCreateOrder}
              disabled={loading || selectedAmount < MIN_AMOUNT}
              className="nt-btn"
            >
              {loading ? (
                <>
                  <span className="nt-spin" />
                  Đang tạo mã QR...
                </>
              ) : (
                <>
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.5" strokeLinecap="round" strokeLinejoin="round">
                    <rect x="3" y="3" width="7" height="7" />
                    <rect x="14" y="3" width="7" height="7" />
                    <rect x="14" y="14" width="7" height="7" />
                    <rect x="3" y="14" width="7" height="7" />
                  </svg>
                  {selectedAmount > 0 ? `Tạo QR nạp ${selectedAmount.toLocaleString("vi-VN")}đ` : "Tạo Mã QR Nạp Tiền"}
                </>
              )}
            </button>

            <div className="nt-note">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round">
                <circle cx="12" cy="12" r="10" />
                <line x1="12" y1="16" x2="12" y2="12" />
                <line x1="12" y1="8" x2="12.01" y2="8" />
              </svg>
              Số tiền tối thiểu 10.000đ - Tối đa 500.000.000đ
            </div>
          </div>
        )}

        {/* STEP 2 */}
        {step === "qr" && order && (
          <div className="nt-grid">
            <div className="nt-card">
              <div className="nt-card-head">
                <div className="nt-card-icon">
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.5" strokeLinecap="round" strokeLinejoin="round">
                    <rect x="3" y="3" width="7" height="7" />
                    <rect x="14" y="3" width="7" height="7" />
                    <rect x="14" y="14" width="7" height="7" />
                    <rect x="3" y="14" width="7" height="7" />
                  </svg>
                </div>
                <div>
                  <div className="nt-card-title">Quét mã QR</div>
                  <div className="nt-card-sub">Mở app ngân hàng để quét</div>
                </div>
              </div>

              <div className="nt-qr-wrap">
                <div className="nt-qr-frame">
                  {/* eslint-disable-next-line @next/next/no-img-element */}
                  <img src={order.qrUrl} alt="QR" className="nt-qr" />
                </div>
              </div>

              <div className={`nt-timer ${timeLeft < 120 ? "is-urgent" : ""}`}>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.5" strokeLinecap="round">
                  <circle cx="12" cy="12" r="10" />
                  <polyline points="12 6 12 12 16 14" />
                </svg>
                <span>Hết hạn sau</span>
                <b>{mm}:{ss}</b>
              </div>

              <div className="nt-pulse">
                <span className="nt-pulse-dot" />
                Đang chờ hệ thống xác nhận...
              </div>
            </div>

            <div className="nt-card">
              <div className="nt-card-head">
                <div className="nt-card-icon nt-icon-blue">
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.5" strokeLinecap="round" strokeLinejoin="round">
                    <path d="M3 21h18M3 10h18M5 6l7-3 7 3M4 10v11M20 10v11M8 14v3M12 14v3M16 14v3" />
                  </svg>
                </div>
                <div>
                  <div className="nt-card-title">Thông tin chuyển khoản</div>
                  <div className="nt-card-sub">Hoặc chuyển khoản thủ công</div>
                </div>
              </div>

              <div className="nt-info-list">
                <InfoRow label="Ngân hàng" value={order.bank} copyKey="bank" copied={copied} onCopy={copy} />
                <InfoRow label="Số tài khoản" value={order.accountNumber} copyKey="acc" copied={copied} onCopy={copy} highlight />
                <InfoRow label="Chủ tài khoản" value={order.accountName} copyKey="name" copied={copied} onCopy={copy} />
                <InfoRow label="Số tiền" value={`${order.amount.toLocaleString("vi-VN")}đ`} copyKey="amt" copied={copied} onCopy={copy} copyValue={String(order.amount)} amount />
                <InfoRow label="Nội dung CK" value={order.orderCode} copyKey="code" copied={copied} onCopy={copy} highlight mono />
              </div>

              <div className="nt-warn">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.5" strokeLinecap="round">
                  <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z" />
                  <line x1="12" y1="9" x2="12" y2="13" />
                  <line x1="12" y1="17" x2="12.01" y2="17" />
                </svg>
                <div>
                  Nhập <b>đúng nội dung</b> <code>{order.orderCode}</code> để hệ thống tự cộng tiền
                </div>
              </div>

              <button
                onClick={() => { setStep("input"); setOrder(null); setPaid(false); }}
                className="nt-back"
              >
                ← Quay lại
              </button>
            </div>
          </div>
        )}

        {/* History */}
        {history.length > 0 && (
          <div className="nt-history">
            <div className="nt-history-title">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.5" strokeLinecap="round">
                <circle cx="12" cy="12" r="10" />
                <polyline points="12 6 12 12 16 14" />
              </svg>
              Lịch sử nạp gần đây
            </div>
            <div className="nt-history-list">
              {history.map((h) => (
                <div key={h.id} className="nt-history-item">
                  <div className="nt-history-icon">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.5" strokeLinecap="round">
                      <line x1="12" y1="1" x2="12" y2="23" />
                      <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" />
                    </svg>
                  </div>
                  <div className="nt-history-body">
                    <div className="nt-history-amount">+{h.amount.toLocaleString("vi-VN")}đ</div>
                    <div className="nt-history-time">{new Date(h.createdAt).toLocaleString("vi-VN")}</div>
                  </div>
                  <div className={`nt-history-status ${h.status === "paid" || h.status === "success" ? "is-ok" : "is-pending"}`}>
                    {h.status === "paid" || h.status === "success" ? "✓ Thành công" : "⏳ Chờ"}
                  </div>
                </div>
              ))}
            </div>
          </div>
        )}
      </div>

      {paid && (
        <div className="nt-overlay">
          <div className="nt-success">
            <div className="nt-success-icon">
              <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="3.5" strokeLinecap="round" strokeLinejoin="round">
                <polyline points="20 6 9 17 4 12" />
              </svg>
            </div>
            <div className="nt-success-title">Nạp tiền thành công!</div>
            <div className="nt-success-desc">
              +{order?.amount.toLocaleString("vi-VN")}đ đã được cộng vào ví
            </div>
            <div className="nt-success-balance">
              Số dư mới: <b>{balance.toLocaleString("vi-VN")}đ</b>
            </div>
            <div className="nt-success-redirect">Đang chuyển hướng...</div>
          </div>
        </div>
      )}

      <style jsx>{`
        .nt-page { position: relative; min-height: 100vh; padding: 100px 20px 80px; background: var(--bg-0); color: var(--text-0); overflow: hidden; }
        .nt-orb { position: absolute; border-radius: 50%; filter: blur(120px); opacity: 0.3; pointer-events: none; z-index: 0; }
        .nt-orb-1 { width: 500px; height: 500px; background: #c4b5fd; top: -180px; left: -180px; animation: ntFloat 14s ease-in-out infinite; }
        .nt-orb-2 { width: 400px; height: 400px; background: #f9a8d4; bottom: -150px; right: -150px; animation: ntFloat 18s ease-in-out infinite reverse; }
        @keyframes ntFloat { 0%, 100% { transform: translate(0, 0) scale(1); } 50% { transform: translate(40px, -40px) scale(1.1); } }
        .nt-wrap { position: relative; z-index: 1; max-width: 960px; margin: 0 auto; }

        .nt-hero { text-align: center; margin-bottom: 36px; }
        .nt-badge { display: inline-flex; align-items: center; gap: 8px; padding: 7px 16px; background: rgba(167, 139, 250, 0.1); border: 1px solid rgba(167, 139, 250, 0.3); border-radius: 999px; color: #7c3aed; font-size: 12px; font-weight: 800; letter-spacing: 0.5px; text-transform: uppercase; margin-bottom: 20px; }
        .nt-badge-dot { width: 7px; height: 7px; background: #a78bfa; border-radius: 50%; box-shadow: 0 0 10px #a78bfa; animation: ntPulse 2s ease-in-out infinite; }
        @keyframes ntPulse { 0%, 100% { opacity: 1; transform: scale(1); } 50% { opacity: 0.5; transform: scale(0.75); } }
        .nt-h1 { font-size: clamp(28px, 5vw, 44px); font-weight: 900; color: var(--text-0); line-height: 1.1; letter-spacing: -0.03em; margin-bottom: 12px; }
        .nt-grad { background: linear-gradient(135deg, #a78bfa 0%, #ec4899 100%); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; }
        .nt-sub { color: var(--text-2); font-size: 15px; margin-bottom: 28px; line-height: 1.6; }
        .nt-balance-card { display: inline-block; padding: 18px 40px; background: var(--bg-1); border: 1.5px solid rgba(167, 139, 250, 0.25); border-radius: 20px; box-shadow: 0 10px 40px rgba(167, 139, 250, 0.15); }
        .nt-balance-label { font-size: 10.5px; font-weight: 800; color: #7c3aed; letter-spacing: 1.5px; text-transform: uppercase; margin-bottom: 6px; }
        .nt-balance-value { font-size: 28px; font-weight: 900; background: linear-gradient(135deg, #a78bfa, #ec4899); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; letter-spacing: -0.02em; }
        .nt-error { padding: 14px 20px; border-radius: 14px; margin-bottom: 20px; background: rgba(239, 68, 68, 0.1); border: 1px solid rgba(239, 68, 68, 0.3); color: #ef4444; font-size: 13.5px; font-weight: 600; }

        .nt-card { background: var(--bg-1); border: 1px solid var(--border); border-radius: 24px; padding: 28px; box-shadow: 0 20px 60px rgba(0,0,0,0.06); }
        @media (max-width: 500px) { .nt-card { padding: 20px; border-radius: 20px; } }

        /* TABS */
        .nt-tabs { display: flex; gap: 6px; padding: 5px; background: var(--bg-2); border-radius: 14px; margin-bottom: 20px; }
        .nt-tab { flex: 1; display: flex; align-items: center; justify-content: center; gap: 7px; padding: 12px 14px; border: none; background: transparent; color: var(--text-2); font-size: 13.5px; font-weight: 800; font-family: inherit; cursor: pointer; border-radius: 10px; transition: all 0.25s; }
        .nt-tab:hover { color: #7c3aed; }
        .nt-tab.is-on { background: linear-gradient(135deg, #a78bfa, #7c3aed); color: #fff; box-shadow: 0 6px 18px rgba(124, 58, 237, 0.3); }

        .nt-card-head { display: flex; align-items: center; gap: 14px; padding-bottom: 18px; border-bottom: 1px solid var(--border); margin-bottom: 22px; }
        .nt-card-icon { width: 46px; height: 46px; display: grid; place-items: center; background: linear-gradient(135deg, #a78bfa, #7c3aed); color: #fff; border-radius: 14px; flex-shrink: 0; box-shadow: 0 6px 18px rgba(167, 139, 250, 0.35); }
        .nt-icon-blue { background: linear-gradient(135deg, #a78bfa, #7c3aed); box-shadow: 0 6px 18px rgba(167, 139, 250, 0.35); }
        .nt-card-title { font-size: 15.5px; font-weight: 800; color: var(--text-0); margin-bottom: 2px; }
        .nt-card-sub { font-size: 12.5px; color: var(--text-2); }

        .nt-input-wrap { position: relative; margin-bottom: 22px; }
        .nt-input { width: 100%; padding: 18px 70px 18px 20px; background: var(--bg-2); border: 1.5px solid var(--border); border-radius: 16px; color: var(--text-0); font-size: 20px; font-weight: 800; font-family: inherit; outline: none; transition: all 0.25s ease; box-sizing: border-box; }
        .nt-input:focus { border-color: #a78bfa; background: var(--bg-1); box-shadow: 0 0 0 4px rgba(167, 139, 250, 0.12); }
        .nt-input::placeholder { color: rgba(156, 163, 175, 0.5); font-weight: 700; }
        .nt-input-suffix { position: absolute; right: 20px; top: 50%; transform: translateY(-50%); font-size: 14px; font-weight: 800; color: var(--text-2); letter-spacing: 0.5px; }

        .nt-quick { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin-bottom: 24px; }
        @media (max-width: 500px) { .nt-quick { grid-template-columns: repeat(2, 1fr); } }
        .nt-chip { padding: 13px 10px; background: var(--bg-1); border: 1.5px solid var(--border); border-radius: 12px; color: var(--text-1); font-size: 13.5px; font-weight: 800; font-family: inherit; cursor: pointer; transition: all 0.25s; text-align: center; }
        .nt-chip:hover { border-color: rgba(167, 139, 250, 0.5); background: rgba(167, 139, 250, 0.08); color: #7c3aed; transform: translateY(-2px); }
        .nt-chip.is-on { background: linear-gradient(135deg, #a78bfa, #ec4899); color: #fff; border-color: transparent; box-shadow: 0 8px 24px rgba(167, 139, 250, 0.4); }

        .nt-btn { width: 100%; display: flex; align-items: center; justify-content: center; gap: 10px; padding: 17px; background: linear-gradient(135deg, #a78bfa 0%, #ec4899 50%, #f59e0b 100%); background-size: 200% 200%; border: none; border-radius: 16px; color: #fff; font-size: 15.5px; font-weight: 800; font-family: inherit; cursor: pointer; transition: all 0.3s; box-shadow: 0 14px 40px rgba(167, 139, 250, 0.4); letter-spacing: 0.3px; animation: ntGradient 4s ease infinite; }
        @keyframes ntGradient { 0%, 100% { background-position: 0% 50%; } 50% { background-position: 100% 50%; } }
        .nt-btn:hover:not(:disabled) { transform: translateY(-3px) scale(1.01); box-shadow: 0 20px 50px rgba(167, 139, 250, 0.55); }
        .nt-btn:disabled { opacity: 0.5; cursor: not-allowed; }
        .nt-spin { width: 18px; height: 18px; border: 2.5px solid rgba(255,255,255,0.3); border-top-color: #fff; border-radius: 50%; animation: ntSpin 0.6s linear infinite; }
        @keyframes ntSpin { to { transform: rotate(360deg); } }

        .nt-note { display: flex; align-items: center; gap: 8px; padding: 12px 16px; margin-top: 16px; background: var(--bg-2); border: 1px solid var(--border); border-radius: 12px; font-size: 12.5px; color: var(--text-2); font-weight: 600; }
        .nt-note svg { color: #a78bfa; flex-shrink: 0; }

        .nt-grid { display: grid; grid-template-columns: 1fr 1.15fr; gap: 20px; align-items: start; }
        @media (max-width: 800px) { .nt-grid { grid-template-columns: 1fr; } }

        .nt-qr-wrap { display: flex; justify-content: center; margin-bottom: 20px; }
        .nt-qr-frame { padding: 14px; background: #fff; border-radius: 20px; box-shadow: 0 16px 50px rgba(0,0,0,0.15); animation: ntQrPop 0.5s cubic-bezier(0.34, 1.56, 0.64, 1); }
        @keyframes ntQrPop { 0% { opacity: 0; transform: scale(0.85); } 100% { opacity: 1; transform: scale(1); } }
        .nt-qr { width: 220px; height: 220px; display: block; border-radius: 10px; }
        @media (max-width: 500px) { .nt-qr { width: 180px; height: 180px; } }

        .nt-timer { display: flex; align-items: center; justify-content: center; gap: 8px; padding: 13px; background: #eff6ff; border: 1px solid #bfdbfe; border-radius: 12px; font-size: 13px; color: #1e40af; font-weight: 700; margin-bottom: 12px; }
        .nt-timer b { font-size: 16px; font-weight: 900; letter-spacing: 0.5px; }
        .nt-timer.is-urgent { background: #fef2f2; border-color: #fecaca; color: #dc2626; animation: ntBlink 1.5s ease-in-out infinite; }
        @keyframes ntBlink { 0%, 100% { opacity: 1; } 50% { opacity: 0.6; } }

        .nt-pulse { display: flex; align-items: center; justify-content: center; gap: 8px; padding: 10px; font-size: 12.5px; color: var(--text-2); font-weight: 600; }
        .nt-pulse-dot { width: 8px; height: 8px; background: #7c3aed; border-radius: 50%; animation: ntPulseDot 1.4s ease-in-out infinite; }
        @keyframes ntPulseDot { 0%, 100% { box-shadow: 0 0 0 0 rgba(124,58,237,0.5); } 50% { box-shadow: 0 0 0 10px rgba(124,58,237,0); } }

        .nt-info-list { display: flex; flex-direction: column; gap: 10px; margin-bottom: 16px; }
        .nt-warn { display: flex; align-items: flex-start; gap: 10px; padding: 14px 16px; background: #fffbeb; border: 1px solid #fde68a; border-radius: 12px; font-size: 12.5px; color: #92400e; line-height: 1.55; margin-bottom: 16px; }
        .nt-warn svg { color: #f59e0b; flex-shrink: 0; margin-top: 1px; }
        .nt-warn code { background: #fef3c7; padding: 2px 8px; border-radius: 5px; font-family: ui-monospace, monospace; font-weight: 800; color: #b45309; font-size: 12px; }

        .nt-back { width: 100%; padding: 12px; background: transparent; border: none; color: var(--text-2); font-size: 13.5px; font-weight: 600; font-family: inherit; cursor: pointer; border-radius: 10px; transition: all 0.2s; }
        .nt-back:hover { background: var(--bg-1); color: var(--text-0); }

        .nt-history { margin-top: 32px; padding: 24px; background: var(--bg-1); border: 1px solid var(--border); border-radius: 20px; }
        .nt-history-title { display: flex; align-items: center; gap: 8px; font-size: 14.5px; font-weight: 800; color: var(--text-0); margin-bottom: 16px; }
        .nt-history-title svg { color: #a78bfa; }
        .nt-history-list { display: flex; flex-direction: column; gap: 10px; }
        .nt-history-item { display: flex; align-items: center; gap: 12px; padding: 14px 16px; background: var(--bg-2); border: 1px solid var(--border); border-radius: 14px; transition: all 0.2s; }
        .nt-history-item:hover { transform: translateX(3px); }
        .nt-history-icon { width: 40px; height: 40px; display: grid; place-items: center; background: rgba(16, 185, 129, 0.12); color: #10b981; border-radius: 12px; flex-shrink: 0; }
        .nt-history-body { flex: 1; min-width: 0; }
        .nt-history-amount { font-size: 14.5px; font-weight: 900; color: #10b981; }
        .nt-history-time { font-size: 11.5px; color: var(--text-2); margin-top: 3px; }
        .nt-history-status { font-size: 11.5px; font-weight: 800; padding: 5px 12px; border-radius: 8px; white-space: nowrap; }
        .nt-history-status.is-ok { background: rgba(16, 185, 129, 0.15); color: #10b981; }
        .nt-history-status.is-pending { background: rgba(251, 191, 36, 0.15); color: #fbbf24; }

        .nt-overlay { position: fixed; inset: 0; background: rgba(0,0,0,0.85); backdrop-filter: blur(12px); z-index: 999; display: grid; place-items: center; padding: 20px; animation: ntFadeIn 0.3s ease; }
        @keyframes ntFadeIn { from { opacity: 0; } to { opacity: 1; } }
        .nt-success { background: linear-gradient(135deg, #0f1a14, #0a0f0d); border: 1.5px solid rgba(16, 185, 129, 0.4); border-radius: 28px; padding: 44px 36px; max-width: 420px; width: 100%; text-align: center; box-shadow: 0 30px 80px rgba(0,0,0,0.6); animation: ntScaleIn 0.5s cubic-bezier(0.34, 1.56, 0.64, 1); }
        @keyframes ntScaleIn { 0% { opacity: 0; transform: scale(0.8) translateY(20px); } 100% { opacity: 1; transform: scale(1) translateY(0); } }
        .nt-success-icon { width: 84px; height: 84px; display: grid; place-items: center; background: linear-gradient(135deg, #10b981, #34d399); color: #fff; border-radius: 50%; margin: 0 auto 20px; box-shadow: 0 16px 40px rgba(16, 185, 129, 0.4); animation: ntPop 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) 0.2s both; }
        @keyframes ntPop { 0% { transform: scale(0); } 70% { transform: scale(1.15); } 100% { transform: scale(1); } }
        .nt-success-title { font-size: 22px; font-weight: 900; color: #10b981; margin-bottom: 8px; }
        .nt-success-desc { font-size: 14px; color: var(--text-2); margin-bottom: 20px; }
        .nt-success-balance { padding: 16px; background: rgba(16, 185, 129, 0.1); border: 1px solid rgba(16, 185, 129, 0.3); border-radius: 14px; font-size: 13.5px; color: var(--text-1); margin-bottom: 20px; }
        .nt-success-balance b { color: #10b981; font-size: 18px; font-weight: 900; display: block; margin-top: 4px; }
        .nt-success-redirect { font-size: 12px; color: var(--text-2); }
      `}</style>
    </main>
  );
}

function InfoRow({
  label, value, copyKey, copyValue, copied, onCopy, highlight, mono, amount,
}: {
  label: string; value: string; copyKey: string; copyValue?: string;
  copied: string | null; onCopy: (text: string, key: string) => void;
  highlight?: boolean; mono?: boolean; amount?: boolean;
}) {
  const isCopied = copied === copyKey;
  return (
    <div className={`nt-row ${highlight ? "is-hl" : ""}`}>
      <div className="nt-row-label">{label}</div>
      <div className="nt-row-right">
        <div className={`nt-row-value ${amount ? "is-amount" : ""} ${mono ? "is-mono" : ""}`}>
          {value}
        </div>
        <button
          type="button"
          onClick={() => onCopy(copyValue || value, copyKey)}
          className={`nt-copy ${isCopied ? "is-copied" : ""}`}
        >
          {isCopied ? (
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="3" strokeLinecap="round" strokeLinejoin="round">
              <polyline points="20 6 9 17 4 12" />
            </svg>
          ) : (
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.5" strokeLinecap="round" strokeLinejoin="round">
              <rect x="9" y="9" width="13" height="13" rx="2" ry="2" />
              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
            </svg>
          )}
        </button>
      </div>

      <style jsx>{`
        .nt-row { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 13px 16px; background: var(--bg-2); border: 1px solid var(--border); border-radius: 13px; transition: all 0.25s; }
        .nt-row:hover { background: var(--bg-1); }
        .nt-row.is-hl { background: #f0fdf4; border-color: #86efac; }
        .nt-row-label { font-size: 12.5px; color: var(--text-2); font-weight: 700; flex-shrink: 0; letter-spacing: 0.2px; }
        .nt-row-right { display: flex; align-items: center; gap: 10px; min-width: 0; }
        .nt-row-value { font-size: 13.5px; font-weight: 800; color: var(--text-0); text-align: right; word-break: break-word; }
        .nt-row-value.is-amount { color: #a78bfa; font-size: 15.5px; }
        .nt-row-value.is-mono { font-family: ui-monospace, monospace; color: #10b981; letter-spacing: 0.5px; font-size: 13px; }
        .nt-copy { display: grid; place-items: center; width: 30px; height: 30px; background: var(--bg-1); border: 1px solid var(--border); border-radius: 8px; color: var(--text-1); cursor: pointer; transition: all 0.2s; flex-shrink: 0; }
        .nt-copy:hover { background: var(--bg-2); color: var(--text-0); transform: scale(1.05); }
        .nt-copy.is-copied { background: #10b981; border-color: #10b981; color: #fff; }
      `}</style>
    </div>
  );
}

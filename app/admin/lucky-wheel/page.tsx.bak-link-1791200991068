"use client";

import { useEffect, useState } from "react";
import AdminPage from "@/components/admin/AdminPage";

interface Spin {
  id: string;
  userId: string;
  username: string;
  email: string;
  label: string;
  value: number;
  type: string;
  createdAt: string;
}
interface TopUser {
  userId: string;
  username: string;
  email: string;
  count: number;
}
interface TodayUser {
  userId: string;
  username: string;
  email: string;
  bonusBalance: number;
  spinsUsed: number;
  spinsLeft: number;
}
interface Stats {
  totalSpins: number;
  todaySpins: number;
  totalPaid: number;
  totalUsers: number;
}

export default function LuckyWheelAdminPage() {
  const [stats, setStats] = useState<Stats | null>(null);
  const [spins, setSpins] = useState<Spin[]>([]);
  const [topUsers, setTopUsers] = useState<TopUser[]>([]);
  const [todayUsers, setTodayUsers] = useState<TodayUser[]>([]);
  const [loading, setLoading] = useState(true);
  const [filter, setFilter] = useState<"all" | "today" | "win">("all");
  const [search, setSearch] = useState("");
  const [resetInput, setResetInput] = useState("");
  const [resetMsg, setResetMsg] = useState("");
  const [resetting, setResetting] = useState(false);

  const load = () => {
    setLoading(true);
    fetch("/api/admin/lucky-wheel")
      .then((r) => r.json())
      .then((d) => {
        if (d.success) {
          setStats(d.stats);
          setSpins(d.spins || []);
          setTopUsers(d.topUsers || []);
          setTodayUsers(d.todayUsers || []);
        }
      })
      .finally(() => setLoading(false));
  };

  useEffect(() => { load(); }, []);

  const handleReset = async (userId: string, mode = "reset", value = 0) => {
    if (!userId.trim()) {
      setResetMsg("❌ Vui lòng nhập User ID hoặc username");
      return;
    }
    setResetting(true);
    setResetMsg("");
    try {
      const res = await fetch(`/api/admin/users/${userId}/reset-spins`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ mode, value }),
      });
      const d = await res.json();
      if (d.success) {
        setResetMsg("✅ " + d.message);
        setResetInput("");
        load();
      } else {
        setResetMsg("❌ " + (d.message || "Lỗi"));
      }
    } catch {
      setResetMsg("❌ Lỗi kết nối");
    } finally {
      setResetting(false);
    }
  };

  const fmt = (n: number) => (n || 0).toLocaleString("vi-VN") + "đ";

  const filteredSpins = spins.filter((s) => {
    if (filter === "win" && s.value <= 0) return false;
    if (filter === "today") {
      const today = new Date();
      today.setHours(0, 0, 0, 0);
      if (new Date(s.createdAt) < today) return false;
    }
    if (search) {
      const q = search.toLowerCase();
      if (!s.username.toLowerCase().includes(q) && !s.email.toLowerCase().includes(q) && !s.label.toLowerCase().includes(q)) {
        return false;
      }
    }
    return true;
  });

  return (
    <AdminPage
      title="🎡 Vòng quay may mắn"
      description="Thống kê + lịch sử + quản lý lượt quay"
      actions={
        <button onClick={load} disabled={loading} className="admin-btn">
          {loading ? "Đang tải..." : "🔄 Làm mới"}
        </button>
      }
    >
      {/* 4 card thống kê */}
      <div style={{ display: "grid", gridTemplateColumns: "repeat(auto-fit, minmax(150px, 1fr))", gap: 12, marginBottom: 20 }}>
        <StatCard label="Tổng lượt quay" value={stats?.totalSpins || 0} color="#3b82f6" icon="🎯" />
        <StatCard label="Hôm nay" value={stats?.todaySpins || 0} color="#fbbf24" icon="📅" />
        <StatCard label="Tổng tiền đã trả" value={fmt(stats?.totalPaid || 0)} color="#10b981" icon="��" />
        <StatCard label="Người chơi" value={stats?.totalUsers || 0} color="#a78bfa" icon="👥" />
      </div>

      {/* Reset lượt quay */}
      <div style={{ background: "var(--bg-1)", border: "1px solid var(--border)", borderRadius: 14, padding: 20, marginBottom: 20 }}>
        <h2 style={{ fontSize: 15, fontWeight: 800, marginBottom: 10, color: "var(--text-0)" }}>
          🔄 Reset / Cộng lượt quay cho user
        </h2>
        <p style={{ fontSize: 12.5, color: "var(--text-2)", marginBottom: 12 }}>
          Nhập User ID hoặc username → nhấn nút. Reset = xóa hết lượt hôm nay (về 3).
        </p>
        <div style={{ display: "flex", gap: 10, flexWrap: "wrap" }}>
          <input
            type="text"
            value={resetInput}
            onChange={(e) => setResetInput(e.target.value)}
            placeholder="User ID hoặc username"
            className="admin-btn"
            style={{ flex: 1, minWidth: 200, textAlign: "left" }}
          />
          <button
            onClick={() => handleReset(resetInput, "reset")}
            disabled={resetting}
            className="admin-btn"
            style={{ background: "linear-gradient(135deg, #f59e0b, #fbbf24)", color: "#fff", fontWeight: 700, borderColor: "transparent" }}
          >
            {resetting ? "..." : "🔄 Reset 3 lượt"}
          </button>
          <button
            onClick={() => handleReset(resetInput, "add", 1)}
            disabled={resetting}
            className="admin-btn"
            style={{ background: "linear-gradient(135deg, #10b981, #34d399)", color: "#fff", fontWeight: 700, borderColor: "transparent" }}
          >
            ➕ Cộng 1 lượt
          </button>
          <button
            onClick={() => handleReset(resetInput, "add", 5)}
            disabled={resetting}
            className="admin-btn"
            style={{ background: "linear-gradient(135deg, #8b5cf6, #a78bfa)", color: "#fff", fontWeight: 700, borderColor: "transparent" }}
          >
            ➕➕ Cộng 5 lượt
          </button>
        </div>
        {resetMsg && (
          <div style={{ marginTop: 10, padding: "8px 12px", borderRadius: 8, fontSize: 13, background: resetMsg.startsWith("✅") ? "rgba(52,211,153,.12)" : "rgba(248,113,113,.12)", color: resetMsg.startsWith("✅") ? "#34d399" : "#f87171" }}>
            {resetMsg}
          </div>
        )}
      </div>

      {/* User đã quay hôm nay */}
      {todayUsers.length > 0 && (
        <div style={{ background: "var(--bg-1)", border: "1px solid var(--border)", borderRadius: 16, padding: 20, marginBottom: 20 }}>
          <h2 style={{ fontSize: 15, fontWeight: 800, marginBottom: 14, color: "var(--text-0)" }}>
            �� User đã quay hôm nay ({todayUsers.length})
          </h2>
          <div style={{ display: "grid", gap: 8 }}>
            {todayUsers.map((u) => (
              <div key={u.userId} style={{ display: "flex", justifyContent: "space-between", alignItems: "center", gap: 10, padding: "10px 12px", background: "var(--bg-2)", borderRadius: 10, flexWrap: "wrap" }}>
                <div style={{ minWidth: 0, flex: 1 }}>
                  <div style={{ fontSize: 14, fontWeight: 700, color: "var(--text-0)" }}>@{u.username}</div>
                  <div style={{ fontSize: 11, color: "var(--text-2)" }}>{u.email}</div>
                </div>
                <div style={{ display: "flex", alignItems: "center", gap: 10, flexWrap: "wrap" }}>
                  <span style={{ fontSize: 12, color: "#fbbf24", fontWeight: 700 }}>
                    🎁 {fmt(u.bonusBalance)}
                  </span>
                  <span style={{
                    padding: "3px 10px",
                    borderRadius: 999,
                    fontSize: 11.5,
                    fontWeight: 800,
                    background: u.spinsLeft > 0 ? "rgba(52,211,153,.15)" : "rgba(248,113,113,.15)",
                    color: u.spinsLeft > 0 ? "#10b981" : "#f87171",
                  }}>
                    {u.spinsLeft}/{3} lượt
                  </span>
                  <button
                    onClick={() => handleReset(u.userId, "reset")}
                    className="admin-btn"
                    style={{ fontSize: 11, padding: "4px 10px" }}
                  >
                    🔄 Reset
                  </button>
                </div>
              </div>
            ))}
          </div>
        </div>
      )}

      {/* Top user */}
      {topUsers.length > 0 && (
        <div style={{ background: "var(--bg-1)", border: "1px solid var(--border)", borderRadius: 16, padding: 20, marginBottom: 20 }}>
          <h2 style={{ fontSize: 15, fontWeight: 800, marginBottom: 14, color: "var(--text-0)" }}>🏆 Top người quay nhiều</h2>
          <div style={{ display: "grid", gap: 8 }}>
            {topUsers.map((u, i) => (
              <div key={u.userId} style={{ display: "flex", justifyContent: "space-between", alignItems: "center", padding: "8px 0", borderBottom: i < topUsers.length - 1 ? "1px solid var(--border)" : "none", gap: 10 }}>
                <div style={{ display: "flex", alignItems: "center", gap: 10, minWidth: 0, flex: 1 }}>
                  <span style={{ width: 24, height: 24, borderRadius: "50%", background: i === 0 ? "#fbbf24" : i === 1 ? "#cbd5e1" : i === 2 ? "#fb923c" : "var(--bg-2)", color: "#fff", display: "grid", placeItems: "center", fontSize: 11, fontWeight: 900, flexShrink: 0 }}>{i + 1}</span>
                  <div style={{ minWidth: 0 }}>
                    <div style={{ fontSize: 14, fontWeight: 700, color: "var(--text-0)", overflow: "hidden", textOverflow: "ellipsis", whiteSpace: "nowrap" }}>@{u.username}</div>
                    <div style={{ fontSize: 11, color: "var(--text-2)", overflow: "hidden", textOverflow: "ellipsis", whiteSpace: "nowrap" }}>{u.email}</div>
                  </div>
                </div>
                <div style={{ display: "flex", alignItems: "center", gap: 10, flexShrink: 0 }}>
                  <span style={{ fontSize: 15, fontWeight: 800, color: "#fbbf24" }}>{u.count} lượt</span>
                  <button
                    onClick={() => handleReset(u.userId, "reset")}
                    className="admin-btn"
                    style={{ fontSize: 11, padding: "4px 8px" }}
                  >
                    🔄
                  </button>
                </div>
              </div>
            ))}
          </div>
        </div>
      )}

      {/* Lịch sử quay */}
      <div style={{ background: "var(--bg-1)", border: "1px solid var(--border)", borderRadius: 16, padding: 20 }}>
        <h2 style={{ fontSize: 15, fontWeight: 800, marginBottom: 14, color: "var(--text-0)" }}>📜 Lịch sử quay</h2>
        <div className="admin-filter" style={{ marginBottom: 14 }}>
          <input
            type="text"
            placeholder="🔍 Tìm theo username, email hoặc phần thưởng..."
            value={search}
            onChange={(e) => setSearch(e.target.value)}
          />
          <div style={{ display: "flex", gap: 6, flexWrap: "wrap" }}>
            {(["all", "today", "win"] as const).map((f) => (
              <button
                key={f}
                onClick={() => setFilter(f)}
                className="admin-btn"
                style={{
                  background: filter === f ? "var(--accent)" : undefined,
                  color: filter === f ? "#fff" : undefined,
                  fontSize: 12.5,
                  padding: "8px 14px",
                }}
              >
                {f === "all" ? "Tất cả" : f === "today" ? "Hôm nay" : "🏆 Trúng thưởng"}
              </button>
            ))}
          </div>
        </div>

        {filteredSpins.length === 0 ? (
          <div style={{ padding: 40, textAlign: "center", color: "var(--text-2)" }}>
            {spins.length === 0 ? "Chưa có lượt quay nào" : "Không có kết quả phù hợp"}
          </div>
        ) : (
          <div style={{ display: "grid", gap: 8 }}>
            {filteredSpins.map((s) => (
              <div key={s.id} style={{ display: "flex", justifyContent: "space-between", alignItems: "center", gap: 10, padding: "10px 12px", background: "var(--bg-2)", borderRadius: 10, flexWrap: "wrap" }}>
                <div style={{ flex: 1, minWidth: 0 }}>
                  <div style={{ fontSize: 13, fontWeight: 700, color: "var(--text-0)" }}>
                    @{s.username} — {s.label}
                  </div>
                  <div style={{ fontSize: 11, color: "var(--text-2)", marginTop: 2 }}>
                    {s.email} · {new Date(s.createdAt).toLocaleString("vi-VN")}
                  </div>
                </div>
                <div style={{ display: "flex", alignItems: "center", gap: 8 }}>
                  <div style={{ fontSize: 14, fontWeight: 800, color: s.value > 0 ? "#10b981" : "var(--text-2)", whiteSpace: "nowrap" }}>
                    {s.value > 0 ? "+" + fmt(s.value) : "—"}
                  </div>
                  <button
                    onClick={() => handleReset(s.userId, "reset")}
                    className="admin-btn"
                    style={{ fontSize: 11, padding: "4px 8px" }}
                  >
                    🔄
                  </button>
                </div>
              </div>
            ))}
          </div>
        )}
      </div>
    </AdminPage>
  );
}

function StatCard({ label, value, color, icon }: { label: string; value: string | number; color: string; icon: string }) {
  return (
    <div style={{ background: "var(--bg-1)", border: "1px solid var(--border)", borderRadius: 14, padding: 18 }}>
      <div style={{ display: "flex", alignItems: "center", gap: 8, marginBottom: 8 }}>
        <span style={{ fontSize: 18 }}>{icon}</span>
        <div style={{ fontSize: 11, color: "var(--text-2)", fontWeight: 700, textTransform: "uppercase" }}>{label}</div>
      </div>
      <div style={{ fontSize: 22, fontWeight: 900, color }}>{value}</div>
    </div>
  );
}

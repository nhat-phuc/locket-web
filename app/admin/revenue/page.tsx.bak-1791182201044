"use client";

import { useEffect, useState } from "react";
import AdminPage from "@/components/admin/AdminPage";

interface DayData { date: string; amount: number; count: number; }
interface TopService { name: string; count: number; revenue: number; }
interface PaymentMethod { method: string; revenue: number; count: number; }
interface RevenueData {
  days: DayData[];
  total: number;
  today: number;
  month: number;
  yesterday: number;
  yesterdayGrowth: number;
  total30d: number;
  totalOrders: number;
  topServices: TopService[];
  byPaymentMethod: PaymentMethod[];
}

const COLORS = ["#3b82f6", "#10b981", "#f59e0b", "#ef4444", "#8b5cf6"];

export default function Page() {
  const [data, setData] = useState<RevenueData | null>(null);
  const [loading, setLoading] = useState(true);

  useEffect(() => {
    fetch("/api/admin/revenue")
      .then((r) => r.json())
      .then((d) => { if (d.success) setData(d); })
      .finally(() => setLoading(false));
  }, []);

  const fmt = (n: number) => (n || 0).toLocaleString("vi-VN") + "đ";
  const fmtShort = (n: number) => {
    if (n >= 1_000_000_000) return (n / 1_000_000_000).toFixed(1) + "B";
    if (n >= 1_000_000) return (n / 1_000_000).toFixed(1) + "M";
    if (n >= 1_000) return (n / 1_000).toFixed(0) + "K";
    return n.toString();
  };

  if (loading || !data) {
    return (
      <AdminPage title="📈 Doanh thu" description="Thống kê doanh thu hệ thống">
        <div style={{ padding: 60, textAlign: "center", color: "#94a3b8" }}>Đang tải...</div>
      </AdminPage>
    );
  }

  const last7Days = data.days.slice(-7);
  const maxAmount = Math.max(...last7Days.map((d) => d.amount), 1);
  const maxAll = Math.max(...data.days.map((d) => d.amount), 1);
  const maxService = Math.max(...data.topServices.map((s) => s.revenue), 1);
  const totalPayment = data.byPaymentMethod.reduce((s, m) => s + m.revenue, 0) || 1;

  const growthColor = data.yesterdayGrowth >= 0 ? "#10b981" : "#ef4444";
  const growthIcon = data.yesterdayGrowth >= 0 ? "▲" : "▼";

  return (
    <AdminPage title="📈 Doanh thu" description="Thống kê doanh thu hệ thống">
      {/* 4 CARDS */}
      <div style={{ display: "grid", gridTemplateColumns: "repeat(auto-fit, minmax(180px, 1fr))", gap: 12, marginBottom: 20 }}>
        <StatCard icon="💰" label="Hôm nay" value={fmt(data.today)} sub={data.yesterday > 0 ? `${growthIcon} ${Math.abs(data.yesterdayGrowth).toFixed(1)}%` : "—"} color="#10b981" subColor={growthColor} />
        <StatCard icon="📅" label="Tháng này" value={fmt(data.month)} sub={`${data.totalOrders} đơn tổng`} color="#3b82f6" />
        <StatCard icon="📊" label="30 ngày qua" value={fmt(data.total30d)} sub={`${data.days.reduce((s, d) => s + d.count, 0)} đơn`} color="#f59e0b" />
        <StatCard icon="💎" label="Tổng cộng" value={fmt(data.total)} sub={`${data.totalOrders} đơn hàng`} color="#8b5cf6" />
      </div>

      {/* 2 CHARTS */}
      <div style={{ display: "grid", gridTemplateColumns: "repeat(auto-fit, minmax(360px, 1fr))", gap: 20, marginBottom: 20 }}>
        {/* BAR CHART */}
        <div style={cardStyle}>
          <h3 style={cardTitleStyle}>📊 7 ngày qua</h3>
          <div style={{ display: "flex", alignItems: "flex-end", justifyContent: "space-between", gap: 8, height: 200, padding: "20px 0" }}>
            {last7Days.map((d) => {
              const height = maxAmount > 0 ? (d.amount / maxAmount) * 100 : 0;
              const date = new Date(d.date);
              const dayLabel = `${date.getDate()}/${date.getMonth() + 1}`;
              return (
                <div key={d.date} style={{ flex: 1, display: "flex", flexDirection: "column", alignItems: "center", gap: 8, height: "100%", justifyContent: "flex-end" }}>
                  <div style={{ fontSize: 10.5, fontWeight: 800, color: d.amount > 0 ? "#10b981" : "#94a3b8" }}>
                    {d.amount > 0 ? fmtShort(d.amount) : "0"}
                  </div>
                  <div title={`${fmt(d.amount)} · ${d.count} đơn`} style={{ width: "100%", maxWidth: 50, height: `${Math.max(height, 2)}%`, background: d.amount > 0 ? "linear-gradient(180deg, #3b82f6, #2563eb)" : "#f1f5f9", borderRadius: 6, transition: "all 0.3s" }} />
                  <div style={{ fontSize: 10.5, color: "#64748b", fontWeight: 700 }}>{dayLabel}</div>
                </div>
              );
            })}
          </div>
        </div>

        {/* LINE CHART */}
        <div style={cardStyle}>
          <h3 style={cardTitleStyle}>📈 Xu hướng 30 ngày</h3>
          <div style={{ padding: "20px 0" }}>
            <svg viewBox="0 0 400 180" style={{ width: "100%", height: 200 }}>
              {[0, 45, 90, 135, 180].map((y) => (
                <line key={y} x1="0" y1={y} x2="400" y2={y} stroke="#f1f5f9" strokeWidth="1" />
              ))}
              <polygon fill="rgba(59,130,246,0.1)" points={`0,180 ${data.days.map((d, i) => {
                const x = (i / (data.days.length - 1)) * 400;
                const y = 180 - (d.amount / maxAll) * 170;
                return `${x},${y}`;
              }).join(" ")} 400,180`} />
              <polyline fill="none" stroke="#3b82f6" strokeWidth="2" strokeLinejoin="round" points={data.days.map((d, i) => {
                const x = (i / (data.days.length - 1)) * 400;
                const y = 180 - (d.amount / maxAll) * 170;
                return `${x},${y}`;
              }).join(" ")} />
            </svg>
            <div style={{ display: "flex", justifyContent: "space-between", fontSize: 10.5, color: "#64748b", fontWeight: 700, marginTop: 8 }}>
              <span>{data.days[0]?.date.slice(5) || ""}</span>
              <span>{data.days[Math.floor(data.days.length / 2)]?.date.slice(5) || ""}</span>
              <span>{data.days[data.days.length - 1]?.date.slice(5) || ""}</span>
            </div>
          </div>
        </div>
      </div>

      {/* TOP + PAYMENT */}
      <div style={{ display: "grid", gridTemplateColumns: "repeat(auto-fit, minmax(360px, 1fr))", gap: 20 }}>
        <div style={cardStyle}>
          <h3 style={cardTitleStyle}>🏆 Top 5 dịch vụ</h3>
          {data.topServices.length === 0 ? (
            <div style={{ padding: 40, textAlign: "center", color: "#94a3b8" }}>Chưa có dữ liệu</div>
          ) : (
            <div style={{ display: "flex", flexDirection: "column", gap: 14 }}>
              {data.topServices.map((s, i) => {
                const percent = (s.revenue / maxService) * 100;
                const color = COLORS[i % COLORS.length];
                return (
                  <div key={s.name}>
                    <div style={{ display: "flex", justifyContent: "space-between", fontSize: 13, marginBottom: 6, fontWeight: 700 }}>
                      <span style={{ color: "#0f172a", display: "flex", alignItems: "center", gap: 6 }}>
                        <span style={{ width: 22, height: 22, borderRadius: "50%", background: color, color: "#fff", display: "grid", placeItems: "center", fontSize: 11, fontWeight: 900 }}>{i + 1}</span>
                        {s.name}
                      </span>
                      <span style={{ color: "#10b981", fontWeight: 900 }}>{fmtShort(s.revenue)} · {s.count} đơn</span>
                    </div>
                    <div style={{ height: 8, background: "#f1f5f9", borderRadius: 4, overflow: "hidden" }}>
                      <div style={{ width: `${percent}%`, height: "100%", background: color, transition: "width 0.5s" }} />
                    </div>
                  </div>
                );
              })}
            </div>
          )}
        </div>

        <div style={cardStyle}>
          <h3 style={cardTitleStyle}>💳 Phương thức thanh toán</h3>
          {data.byPaymentMethod.length === 0 ? (
            <div style={{ padding: 40, textAlign: "center", color: "#94a3b8" }}>Chưa có dữ liệu</div>
          ) : (
            <div style={{ display: "flex", flexDirection: "column", gap: 14 }}>
              {data.byPaymentMethod.map((m, i) => {
                const percent = (m.revenue / totalPayment) * 100;
                const labels: Record<string, string> = { bank_transfer: "🏦 Chuyển khoản", momo: "📱 MoMo", vnpay: "💳 VNPay", sepay: "💸 SePay", wallet: "👛 Ví", admin: "👑 Admin" };
                const color = COLORS[i % COLORS.length];
                return (
                  <div key={m.method}>
                    <div style={{ display: "flex", justifyContent: "space-between", fontSize: 13, marginBottom: 6, fontWeight: 700 }}>
                      <span style={{ color: "#0f172a" }}>{labels[m.method] || m.method}</span>
                      <span style={{ color, fontWeight: 900 }}>{fmtShort(m.revenue)} ({percent.toFixed(0)}%)</span>
                    </div>
                    <div style={{ height: 8, background: "#f1f5f9", borderRadius: 4, overflow: "hidden" }}>
                      <div style={{ width: `${percent}%`, height: "100%", background: color, transition: "width 0.5s" }} />
                    </div>
                  </div>
                );
              })}
            </div>
          )}
        </div>
      </div>
    </AdminPage>
  );
}

function StatCard({ icon, label, value, sub, color, subColor }: { icon: string; label: string; value: string; sub?: string; color: string; subColor?: string; }) {
  return (
    <div style={cardStyle}>
      <div style={{ display: "flex", alignItems: "center", gap: 10, marginBottom: 12 }}>
        <div style={{ width: 40, height: 40, borderRadius: 10, background: `${color}15`, color, display: "grid", placeItems: "center", fontSize: 18, flexShrink: 0 }}>{icon}</div>
        <div style={{ fontSize: 11, color: "#64748b", fontWeight: 700, textTransform: "uppercase", letterSpacing: "0.3px" }}>{label}</div>
      </div>
      <div style={{ fontSize: 24, fontWeight: 900, color, lineHeight: 1.1 }}>{value}</div>
      {sub && <div style={{ fontSize: 11.5, color: subColor || "#94a3b8", marginTop: 6, fontWeight: 700 }}>{sub}</div>}
    </div>
  );
}

const cardStyle: React.CSSProperties = {
  background: "#fff",
  border: "1px solid #e2e8f0",
  borderRadius: 16,
  padding: 20,
  boxShadow: "0 1px 3px rgba(0,0,0,0.04)",
};

const cardTitleStyle: React.CSSProperties = {
  fontSize: 15,
  fontWeight: 800,
  color: "#0f172a",
  margin: 0,
  marginBottom: 16,
  display: "flex",
  alignItems: "center",
  gap: 8,
};

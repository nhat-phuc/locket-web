        }
        .hd-cta-primary {
          background: #fff;
          color: #7c3aed;
          box-shadow: 0 12px 32px rgba(0, 0, 0, 0.2);
        }
        .hd-cta-primary:hover {
          transform: translateY(-3px);
          box-shadow: 0 16px 40px rgba(0, 0, 0, 0.25);
        }
        .hd-cta-secondary {
          background: rgba(255, 255, 255, 0.15);
          color: #fff;
          border: 1.5px solid rgba(255, 255, 255, 0.4);
          backdrop-filter: blur(10px);
        }
        .hd-cta-secondary:hover {
          background: rgba(255, 255, 255, 0.25);
          transform: translateY(-3px);
        }

        /* ═══ FAQ ═══ */
        .hd-faq-list {
          display: flex;
          flex-direction: column;
          gap: 12px;
        }

        .hd-faq-item {
          background: rgba(255, 255, 255, 0.04);
          backdrop-filter: blur(20px);
          border: 1.5px solid rgba(167, 139, 250, 0.2);
          border-radius: 16px;
          overflow: hidden;
          cursor: pointer;
          transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .hd-faq-item:hover {
          border-color: rgba(167, 139, 250, 0.4);
        }
        .hd-faq-item.open {
          border-color: #a78bfa;
          background: linear-gradient(135deg, rgba(167, 139, 250, 0.08), rgba(244, 114, 182, 0.04));
          box-shadow: 0 8px 24px rgba(124, 58, 237, 0.12);
        }

        .hd-faq-q {
          display: flex;
          align-items: center;
          gap: 14px;
          padding: 18px 20px;
          user-select: none;
        }
        .hd-faq-icon {
          width: 28px;
          height: 28px;
          border-radius: 50%;
          background: rgba(167, 139, 250, 0.15);
          color: #a78bfa;
          display: grid;
          place-items: center;
          font-size: 18px;
          font-weight: 900;
          flex-shrink: 0;
          transition: all 0.3s;
        }
        .hd-faq-item.open .hd-faq-icon {
          background: linear-gradient(135deg, #7c3aed, #a78bfa);
          color: #fff;
          transform: rotate(180deg);
        }
        .hd-faq-text {
          flex: 1;
          font-size: 15px;
          font-weight: 700;
          color: var(--text-0);
        }

        .hd-faq-a {
          max-height: 0;
          overflow: hidden;
          transition: max-height 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .hd-faq-item.open .hd-faq-a {
          max-height: 300px;
        }
        .hd-faq-a-inner {
          padding: 0 20px 20px 62px;
          font-size: 14px;
          color: var(--text-2);
          line-height: 1.7;
        }

        /* ═══ SUPPORT ═══ */
        .hd-support {
          padding: 40px 32px;
          background: linear-gradient(135deg, rgba(167, 139, 250, 0.08), rgba(244, 114, 182, 0.05));
          backdrop-filter: blur(20px);
          border: 1.5px solid rgba(167, 139, 250, 0.25);
          border-radius: 24px;
          text-align: center;
          position: relative;
          overflow: hidden;
        }
        .hd-support::before {
          content: "";
          position: absolute;
          top: -50%;
          left: 50%;
          transform: translateX(-50%);
          width: 400px;
          height: 400px;
          background: radial-gradient(circle, rgba(167, 139, 250, 0.2), transparent 70%);
          pointer-events: none;
        }
        .hd-support-content {
          position: relative;
          z-index: 1;
        }
        .hd-support h3 {
          font-size: 22px;
          font-weight: 900;
          color: var(--text-0);
          margin-bottom: 8px;
        }
        .hd-support p {
          font-size: 15px;
          color: var(--text-2);
          margin-bottom: 24px;
        }
        .hd-support-links {
          display: flex;
          gap: 12px;
          justify-content: center;
          flex-wrap: wrap;
        }
        .hd-support-btn {
          display: inline-flex;
          align-items: center;
          gap: 8px;
          padding: 14px 28px;
          border-radius: 14px;
          font-size: 15px;
          font-weight: 800;
          text-decoration: none;
          transition: all 0.3s;
        }
        .hd-support-btn.zalo {
          background: linear-gradient(135deg, #0068ff, #3b82f6);
          color: #fff;
          box-shadow: 0 8px 24px rgba(0, 104, 255, 0.3);
        }
        .hd-support-btn.zalo:hover {
          transform: translateY(-3px);
          box-shadow: 0 12px 32px rgba(0, 104, 255, 0.45);
        }
        .hd-support-btn.tele {
          background: linear-gradient(135deg, #0088cc, #60a5fa);
          color: #fff;
          box-shadow: 0 8px 24px rgba(0, 136, 204, 0.3);
        }
        .hd-support-btn.tele:hover {
          transform: translateY(-3px);
          box-shadow: 0 12px 32px rgba(0, 136, 204, 0.45);
        }

        /* ═══ RESPONSIVE ═══ */
        @media (max-width: 640px) {
          .hd-page { padding: 24px 12px 60px; }
          .hd-title { font-size: 30px; }
          .hd-subtitle { font-size: 14px; }
          .hd-hero { margin-bottom: 32px; }

          .hd-hero-stats { padding: 12px 20px; gap: 14px; }
          .hd-hero-stat-num { font-size: 16px; }

          .hd-section-title { font-size: 22px; }
          .hd-section { margin-bottom: 40px; }

          .hd-tl-item { padding: 16px; gap: 14px; }
          .hd-tl-line { left: 30px; top: 48px; }
          .hd-tl-dot { width: 28px; height: 28px; }
          .hd-tl-num { font-size: 12px; }
          .hd-tl-icon-wrap { width: 38px; height: 38px; font-size: 18px; }
          .hd-tl-title { font-size: 14px; }
          .hd-tl-desc { font-size: 13px; }
          .hd-tl-tip { font-size: 12px; padding: 8px 12px; }

          .hd-tips-grid { grid-template-columns: 1fr; }
          .hd-tip-card { padding: 20px 16px; }

          .hd-cta { padding: 32px 20px; border-radius: 20px; }
          .hd-cta h2 { font-size: 22px; }
          .hd-cta p { font-size: 14px; }
          .hd-cta-buttons { flex-direction: column; }
          .hd-cta-btn { width: 100%; justify-content: center; }

          .hd-faq-q { padding: 16px; }
          .hd-faq-text { font-size: 14px; }
          .hd-faq-a-inner { padding: 0 16px 16px 58px; font-size: 13px; }

          .hd-support { padding: 32px 20px; border-radius: 20px; }
          .hd-support h3 { font-size: 18px; }
          .hd-support-links { flex-direction: column; }
          .hd-support-btn { width: 100%; justify-content: center; }
        }
      `}</style>
    </div>
  );
}

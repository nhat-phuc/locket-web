                  onClick={() => setActiveStep(s.n)}
                  style={{
                    "--c": s.color,
                    "--bg": s.bg,
                    animationDelay: `${i * 0.08}s`,
                  } as React.CSSProperties}
                >
                  {/* Đường nối */}
                  {i < STEPS.length - 1 && <div className="hd-tl-line" />}

                  {/* Dot */}
                  <div className="hd-tl-dot">
                    <span className="hd-tl-num">{s.n}</span>
                  </div>

                  {/* Content */}
                  <div className="hd-tl-content">
                    <div className="hd-tl-head">
                      <div className="hd-tl-icon-wrap" style={{ background: s.bg }}>

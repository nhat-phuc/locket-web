        .pt-progress { display: flex; align-items: center; background: rgba(255,255,255,.85); backdrop-filter: blur(12px); padding: 14px 20px; border-radius: 16px; margin-bottom: 20px; box-shadow: 0 4px 20px rgba(124,58,237,.06); }

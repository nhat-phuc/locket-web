        .pt-sum-total strong { font-size: 22px; color: #7c3aed; }
        .pt-green { color: #10b981 !important; }
        .pt-purple { color: #7c3aed !important; }
        .pt-mono { font-family: ui-monospace, monospace; font-size: 13px; }
        .pt-btn-main { width: 100%; padding: 16px; background: linear-gradient(135deg, #7c3aed, #a78bfa); color: #fff; border: none; border-radius: 14px; font-size: 15px; font-weight: 700; cursor: pointer; transition: all .18s; box-shadow: 0 6px 20px rgba(124,58,237,.3); }
        .pt-btn-main:hover:not(:disabled) { transform: translateY(-2px); box-shadow: 0 10px 28px rgba(124,58,237,.4); }
        .pt-btn-main:disabled { opacity: .5; cursor: not-allowed; }
        .pt-btn-alt { width: 100%; padding: 16px; background: linear-gradient(135deg, #10b981, #34d399); color: #fff; border: none; border-radius: 14px; font-size: 15px; font-weight: 700; cursor: pointer; margin-top: 10px; transition: all .18s; }
        .pt-btn-alt.off { background: #cbd5e1; cursor: not-allowed; }
        .pt-btn-ghost { width: 100%; padding: 12px; background: transparent; border: 1px solid #e2e8f0; border-radius: 12px; color: #64748b; font-size: 14px; font-weight: 600; cursor: pointer; margin-top: 10px; }
        .pt-btn-ghost:hover { background: #f8fafc; }
        .pt-timer { text-align: center; color: #64748b; font-size: 14px; margin-bottom: 16px; }
        .pt-timer b { color: #7c3aed; }
        .pt-qr { text-align: center; margin: 20px 0; }
        .pt-qr img { max-width: 300px; width: 100%; border-radius: 16px; box-shadow: 0 8px 32px rgba(0,0,0,.08); }
        .pt-wait { display: flex; align-items: center; justify-content: center; gap: 8px; color: #64748b; font-size: 13px; margin-top: 16px; }
        .pt-pulse { width: 8px; height: 8px; border-radius: 50%; background: #10b981; animation: pulse 1.2s infinite; }
        @keyframes pulse { 0%,100% { opacity: 1; transform: scale(1); } 50% { opacity: .5; transform: scale(1.4); } }
        .pt-card-success { text-align: center; padding: 40px 24px; }
        .pt-success-ico { font-size: 64px; margin-bottom: 16px; }
        .pt-card-success h2 { margin: 0 0 8px; color: #10b981; }
        .pt-dim { color: #94a3b8; font-size: 13px; }
        @media (max-width: 480px) {
          .pt-head h1 { font-size: 26px; }
          .pt-card { padding: 20px 16px; }
        }
      `}</style>
    </div>
  );
}

"use client";

import { useEffect, useState } from "react";
import { useRouter, useSearchParams } from "next/navigation";

interface Pkg {
  id: string;
  name: string;
  duration: string;
  price: number;
  originalPrice?: number | null;
  isPopular?: boolean;
}
interface Service {
  id: string;
  name: string;
  slug: string;
  type: string;
  price: number;
  packages?: Pkg[];
}
interface Order {
  id: string;
  orderCode: string;
  serviceName: string;
  finalAmount: number;
  locketUsername: string;
  status: string;
}

type Step = "info" | "method" | "qr" | "success";

export default function ThanhToanContent() {
  const router = useRouter();
  const params = useSearchParams();
  const serviceId = params.get("serviceId");
  const packageId = params.get("packageId");

  const [balance, setBalance] = useState(0);
  const [service, setService] = useState<Service | null>(null);
  const [pkg, setPkg] = useState<Pkg | null>(null);
  const [locketUsername, setLocketUsername] = useState("");
  const [coupon, setCoupon] = useState("");
  const [order, setOrder] = useState<Order | null>(null);
  const [step, setStep] = useState<Step>("info");
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState("");
  const [timeLeft, setTimeLeft] = useState(15 * 60);

  const [usernameChecking, setUsernameChecking] = useState(false);
  const [usernameValid, setUsernameValid] = useState<boolean | null>(null);
  const [usernameError, setUsernameError] = useState("");
  const [profile, setProfile] = useState<any>(null);

  useEffect(() => {
    if (!serviceId) router.push("/bang-gia");
  }, [serviceId, router]);

  // Load service + package từ URL
  useEffect(() => {
    if (!serviceId) return;
    fetch("/api/services")
      .then((r) => r.json())
      .then((d) => {
        const s = (d.services || []).find(
          (x: any) => x.slug === serviceId || x.id === serviceId || x.type === serviceId
        );
        if (s) {
          setService(s);
          if (packageId) {
            const p = (s.packages || []).find((x: Pkg) => x.id === packageId);
            if (p) setPkg(p);
            else setPkg(s.packages?.[0] || null);
          } else {
            setPkg(s.packages?.[0] || null);
          }
        }
      })
      .catch(() => {});
  }, [serviceId, packageId]);

  useEffect(() => {
    const stored = sessionStorage.getItem("locket_user");
    if (!stored) { router.push("/dang-nhap"); return; }
    try {
      const u = JSON.parse(stored);
      if (u.email) {
        fetch(`/api/balance?email=${encodeURIComponent(u.email)}`)
          .then((r) => r.json())
          .then((d) => { if (typeof d.balance === "number") setBalance(d.balance); })
          .catch(() => {});
      }
    } catch {}
  }, [router]);

  useEffect(() => {
    const t = locketUsername.trim();
    if (!t || t.length < 2) {
      setUsernameValid(null); setUsernameError(""); setUsernameChecking(false); setProfile(null);
      return;
    }
    setUsernameChecking(true);
    const timer = setTimeout(async () => {
      try {
        const r = await fetch(`/api/locket/check?username=${encodeURIComponent(t)}`);
        const d = await r.json();
        if (d.valid) { setUsernameValid(true); setUsernameError(""); setProfile(d); }
        else { setUsernameValid(false); setUsernameError(d.message || "Username không đúng"); setProfile(null); }
      } catch {
        setUsernameValid(false); setUsernameError("Không thể kiểm tra"); setProfile(null);
      } finally { setUsernameChecking(false); }
    }, 600);
    return () => clearTimeout(timer);
  }, [locketUsername]);

  useEffect(() => {
    if (step !== "qr" || timeLeft <= 0) return;
    const t = setInterval(() => setTimeLeft((v) => Math.max(0, v - 1)), 1000);
    return () => clearInterval(t);
  }, [step, timeLeft]);

  useEffect(() => {
    if (step !== "qr" || !order) return;
    const check = async () => {
      try {
        const r = await fetch(`/api/payments/check?orderId=${order.id}`, { cache: "no-store" });
        const d = await r.json();
        if (d.success && (d.status === "paid" || d.status === "completed")) {
          setStep("success");
          setTimeout(() => router.push(`/thanh-toan/thanh-cong?orderId=${order.id}`), 2500);
        }
      } catch {}
    };
    check();
    const iv = setInterval(check, 3000);
    return () => clearInterval(iv);
  }, [step, order, router]);

  const currentPrice = pkg?.price || service?.price || 0;
  const currentOriginal = pkg?.originalPrice || service?.price || 0;

  const createOrder = async () => {
    if (!serviceId) return setError("Thiếu thông tin dịch vụ");
    if (usernameValid !== true) return setError(usernameError || "Username không đúng");
    setLoading(true); setError("");
    try {
      const r = await fetch("/api/orders", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          serviceId,
          packageId: pkg?.id || undefined,
          locketUsername: profile?.username || locketUsername.trim(),
          couponCode: coupon.trim() || undefined,
        }),
      });
      const d = await r.json();
      if (d.success) { setOrder(d.order); setStep("method"); }
      else setError(d.message || "Không thể tạo đơn");
    } catch { setError("Lỗi kết nối"); }
    finally { setLoading(false); }
  };

  const payWithBalance = async () => {
    if (!order) return;
    if (balance < order.finalAmount) return setError("Số dư không đủ");
    setLoading(true); setError("");
    try {
      const r = await fetch("/api/payments/pay-with-balance", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ orderId: order.id }),
      });
      const d = await r.json();
      if (d.success) {
        setStep("success");
        setTimeout(() => router.push(`/thanh-toan/thanh-cong?orderId=${order.id}`), 2500);
      } else setError(d.message || "Thanh toán thất bại");
    } catch { setError("Lỗi kết nối"); }
    finally { setLoading(false); }
  };

  const showQR = async () => {
    if (!order) return;
    setLoading(true); setError("");
    try {
      const r = await fetch("/api/payments/create", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ orderId: order.id, paymentMethod: "bank_transfer" }),
      });
      const d = await r.json();
      if (d.success) { setStep("qr"); setTimeLeft(15 * 60); }
      else setError(d.message || "Không tạo được QR");
    } catch { setError("Lỗi kết nối"); }
    finally { setLoading(false); }
  };

  const fmt = (n: number) => n.toLocaleString("vi-VN") + "đ";
  const fmtTime = (s: number) => `${Math.floor(s / 60)}:${(s % 60).toString().padStart(2, "0")}`;
  const notEnough = balance < (order?.finalAmount || 0);

  if (!serviceId) return <div style={{ padding: 80, textAlign: "center" }}>Đang chuyển hướng...</div>;

  return (
    <div className="pt-page">
      <div className="pt-bg-glow pt-bg-glow-1" />
      <div className="pt-bg-glow pt-bg-glow-2" />

      <div className="pt-wrap">
        <header className="pt-head">
          <h1>Thanh toán</h1>
          <p>Hoàn tất thông tin để tạo đơn hàng</p>
        </header>

        <div className="pt-steps">
          {[
            { key: "info", n: 1, label: "Thông tin" },
            { key: "method", n: 2, label: "Thanh toán" },
            { key: "success", n: 3, label: "Hoàn tất" },
          ].map((s, i) => {
            const active = step === s.key;
            const done =
              (s.key === "info" && step !== "info") ||
              (s.key === "method" && (step === "qr" || step === "success")) ||
              (s.key === "success" && step === "success");
            return (
              <div key={s.key} className="pt-step">
                <div className={`pt-step-num ${active ? "active" : ""} ${done ? "done" : ""}`}>
                  {done ? "✓" : s.n}
                </div>
                <span className={`pt-step-label ${active ? "active" : ""}`}>{s.label}</span>
                {i < 2 && <div className={`pt-step-bar ${done ? "done" : ""}`} />}
              </div>
            );
          })}
        </div>

        {error && (
          <div className="pt-alert">
            <span>⚠</span> {error}
          </div>
        )}

        {/* STEP 1 */}
        {step === "info" && (
          <div className="pt-card">
            {/* Thông tin gói đã chọn */}
            <div className="pt-summary" style={{ marginBottom: 20 }}>
              <div className="pt-sum-row">
                <span>Dịch vụ</span>
                <b>{service?.name || "Đang tải..."}</b>
              </div>
              <div className="pt-sum-row">
                <span>Gói</span>
                <b>{pkg?.name || "Đang tải..."}</b>
              </div>
              {currentOriginal > currentPrice && (
                <div className="pt-sum-row">
                  <span>Tiết kiệm</span>
                  <b className="pt-green">-{fmt(currentOriginal - currentPrice)}</b>
                </div>
              )}
              <div className="pt-sum-total">
                <span>Tổng cộng</span>
                <strong>{fmt(currentPrice)}</strong>
              </div>
            </div>

            {/* Username */}
            <div className="pt-block">
              <label className="pt-label">
                Username Locket <span className="pt-req">*</span>
              </label>
              <div className={`pt-input-box ${usernameValid === true ? "ok" : ""} ${usernameValid === false ? "err" : ""}`}>
                <span className="pt-input-ico">@</span>
                <input
                  type="text"
                  value={locketUsername}
                  onChange={(e) => setLocketUsername(e.target.value)}
                  placeholder="Nhập username Locket"
                  className="pt-input"
                />
                <span className="pt-input-status">
                  {usernameChecking && <span className="pt-spin" />}
                  {!usernameChecking && usernameValid === true && <span className="pt-check">✓</span>}
                  {!usernameChecking && usernameValid === false && <span className="pt-cross">✕</span>}
                </span>
              </div>
              {usernameError && <div className="pt-hint err">{usernameError}</div>}
              {usernameValid === true && profile && (
                <div className="pt-profile">
                  <div className="pt-avatar">
                    {profile.avatar
                      ? <img src={profile.avatar} alt="" referrerPolicy="no-referrer" />
                      : <span>{(profile.username || "U").charAt(0).toUpperCase()}</span>}
                  </div>
                  <div>
                    <div className="pt-profile-name">@{profile.username}</div>
                    <div className="pt-profile-badge">● Đã tìm thấy</div>
                  </div>
                </div>
              )}
            </div>

            {/* Coupon */}
            <div className="pt-block">
              <label className="pt-label">Mã giảm giá (không bắt buộc)</label>
              <input
                type="text"
                value={coupon}
                onChange={(e) => setCoupon(e.target.value.toUpperCase())}
                placeholder="VD: SALE10"
                className="pt-input-simple"
              />
            </div>

            <button
              onClick={createOrder}
              disabled={loading || usernameValid !== true}
              className="pt-btn-main"
            >
              {loading ? "Đang xử lý..." : "Tiếp tục →"}
            </button>

            <button onClick={() => router.push("/bang-gia")} className="pt-btn-ghost">
              ← Đổi gói khác
            </button>
          </div>
        )}

        {/* STEP 2 */}
        {step === "method" && order && (
          <div className="pt-card">
            <h2 className="pt-h2">Chọn phương thức thanh toán</h2>

            <div className="pt-summary">
              <div className="pt-sum-row">
                <span>Mã đơn</span>
                <b className="pt-mono">{order.orderCode}</b>
              </div>
              <div className="pt-sum-row">
                <span>Dịch vụ</span>
                <b>{order.serviceName}</b>
              </div>
              <div className="pt-sum-total">
                <span>Tổng</span>
                <strong>{fmt(order.finalAmount)}</strong>
              </div>
            </div>

            <button onClick={showQR} disabled={loading} className="pt-btn-main">
              💳 Chuyển khoản QR
            </button>

            <button
              onClick={payWithBalance}
              disabled={loading || notEnough}
              className={`pt-btn-alt ${notEnough ? "off" : ""}`}
            >
              💰 Trả bằng số dư — {fmt(balance)}
            </button>

            <button onClick={() => setStep("info")} className="pt-btn-ghost">
              ← Quay lại
            </button>
          </div>
        )}

        {/* STEP 3: QR */}
        {step === "qr" && order && (
          <div className="pt-card">
            <h2 className="pt-h2">Quét mã để thanh toán</h2>
            <div className="pt-timer">Hết hạn sau <b>{fmtTime(timeLeft)}</b></div>

            <div className="pt-summary">
              <div className="pt-sum-row">
                <span>Số tiền</span>
                <b className="pt-purple">{fmt(order.finalAmount)}</b>
              </div>
              <div className="pt-sum-row">
                <span>Nội dung CK</span>
                <b className="pt-mono">{order.orderCode}</b>
              </div>
            </div>

            <div className="pt-qr">
              <img
                src={`https://qr.sepay.vn/img?acc=36886368888&bank=TPBANK&amount=${order.finalAmount}&des=${order.orderCode}`}
                alt="QR"
              />
            </div>

            <div className="pt-wait">
              <span className="pt-pulse" /> Đang chờ thanh toán...
            </div>

            <button onClick={() => setStep("method")} className="pt-btn-ghost">
              ← Chọn phương thức khác
            </button>
          </div>
        )}

        {/* STEP 4 */}
        {step === "success" && (
          <div className="pt-card pt-card-success">
            <div className="pt-success-ico">✅</div>
            <h2>Thanh toán thành công!</h2>
            <p>Đơn <b>{order?.orderCode}</b> đã được xác nhận</p>
            <p className="pt-dim">Đang chuyển trang...</p>
          </div>
        )}
      </div>

      <style jsx>{`
        .pt-page { min-height: 100vh; padding: 40px 16px 80px; position: relative; overflow: hidden; }
        .pt-bg-glow { position: absolute; border-radius: 50%; filter: blur(100px); opacity: .35; pointer-events: none; }
        .pt-bg-glow-1 { width: 400px; height: 400px; background: #a78bfa; top: -100px; left: -100px; }
        .pt-bg-glow-2 { width: 400px; height: 400px; background: #f472b6; bottom: -100px; right: -100px; }
        .pt-wrap { max-width: 560px; margin: 0 auto; position: relative; }
        .pt-head { text-align: center; margin-bottom: 24px; }
        .pt-head h1 { font-size: 32px; font-weight: 800; margin: 0 0 6px; background: linear-gradient(135deg, #7c3aed, #ec4899); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
        .pt-head p { color: #888; margin: 0; font-size: 14px; }
        .pt-steps { display: flex; align-items: center; justify-content: space-between; background: #fff; padding: 16px 20px; border-radius: 16px; margin-bottom: 20px; box-shadow: 0 4px 20px rgba(124,58,237,.06); }
        .pt-step { display: flex; align-items: center; gap: 8px; position: relative; flex: 1; }
        .pt-step:last-child { flex: 0; }
        .pt-step-num { width: 32px; height: 32px; border-radius: 50%; background: #f1f5f9; color: #94a3b8; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 14px; flex-shrink: 0; }
        .pt-step-num.active { background: linear-gradient(135deg, #7c3aed, #a78bfa); color: #fff; box-shadow: 0 4px 12px rgba(124,58,237,.4); }
        .pt-step-num.done { background: #10b981; color: #fff; }
        .pt-step-label { font-size: 13px; font-weight: 600; color: #94a3b8; }
        .pt-step-label.active { color: #7c3aed; }
        .pt-step-bar { flex: 1; height: 2px; background: #e2e8f0; margin: 0 12px; border-radius: 2px; }
        .pt-step-bar.done { background: #10b981; }
        .pt-alert { background: #fef2f2; color: #dc2626; padding: 12px 16px; border-radius: 12px; margin-bottom: 16px; font-size: 14px; display: flex; gap: 8px; align-items: center; border: 1px solid #fecaca; }
        .pt-card { background: #fff; border-radius: 20px; padding: 24px; box-shadow: 0 8px 40px rgba(124,58,237,.08); border: 1px solid #f1f5f9; }
        .pt-h2 { font-size: 18px; font-weight: 700; margin: 0 0 16px; text-align: center; }
        .pt-block { margin-bottom: 20px; }
        .pt-label { display: block; font-size: 13px; font-weight: 700; color: #334155; margin-bottom: 10px; }
        .pt-req { color: #ef4444; }
        .pt-input-box { display: flex; align-items: center; background: #f8fafc; border: 2px solid #e2e8f0; border-radius: 12px; padding: 0 14px; transition: all .18s; }

        .pt-input-box.ok { border-color: #10b981; background: #f0fdf4; }
        .pt-input-box.err { border-color: #ef4444; background: #fef2f2; }
        .pt-input-ico { color: #94a3b8; font-weight: 700; margin-right: 6px; }

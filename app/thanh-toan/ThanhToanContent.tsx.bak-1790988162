        .pt-input-simple { width: 100%; padding: 14px 16px; background: #f8fafc; border: 2px solid #e2e8f0; border-radius: 12px; font-size: 15px; outline: none; transition: all .18s; }
        .pt-input-simple:focus { border-color: #a78bfa; background: #fff; }
        .pt-summary { background: linear-gradient(135deg, #faf5ff, #fdf4ff); border: 1px solid #e9d5ff; border-radius: 14px; padding: 16px; margin-bottom: 16px; }

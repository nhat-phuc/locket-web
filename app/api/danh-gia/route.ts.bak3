import { NextResponse } from "next/server";
import { prisma } from "@/lib/db";
import { getSession } from "@/lib/session";
import { writeFile, mkdir } from "fs/promises";
import { join } from "path";
import crypto from "crypto";

export async function POST(req: Request) {
  try {
    // 1. Lấy session user
    const session = await getSession();
    if (!session) {
      return NextResponse.json(
        { success: false, error: "Vui lòng đăng nhập để đánh giá" },
        { status: 401 }
      );
    }

    // 2. Đọc form data
    const formData = await req.formData();
    const content = String(formData.get("content") || "").trim();
    const image = formData.get("image") as File | null;

    if (!content || content.length < 5) {
      return NextResponse.json(
        { success: false, error: "Nội dung đánh giá quá ngắn (tối thiểu 5 ký tự)" },
        { status: 400 }
      );
    }

    if (!image) {
      return NextResponse.json(
        { success: false, error: "Vui lòng đính kèm ảnh màn hình" },
        { status: 400 }
      );
    }

    // Kiểm tra kích thước ảnh (max 5MB)
    if (image.size > 5 * 1024 * 1024) {
      return NextResponse.json(
        { success: false, error: "Ảnh không được vượt quá 5MB" },
        { status: 400 }
      );
    }

    // 3. Lấy user từ DB
    const user = await prisma.user.findUnique({
      where: { id: session.userId },
      select: { id: true, name: true, username: true, picture: true, email: true },
    });

    if (!user) {
      return NextResponse.json(
        { success: false, error: "Không tìm thấy user" },
        { status: 404 }
      );
    }

    // 4. Upload ảnh vào public/uploads/reviews
    const uploadDir = join(process.cwd(), "public", "uploads", "reviews");
    await mkdir(uploadDir, { recursive: true });

    const ext = image.name.split(".").pop()?.toLowerCase() || "jpg";
    const fileName = `${crypto.randomBytes(8).toString("hex")}.${ext}`;
    const filePath = join(uploadDir, fileName);

    const bytes = await image.arrayBuffer();
    await writeFile(filePath, Buffer.from(bytes));

    const imageUrl = `/uploads/reviews/${fileName}`;

    // 5. Lưu đánh giá vào DB (status pending, chờ admin duyệt)
    const displayName = user.name || user.username || user.email.split("@")[0];
    const initial = displayName.charAt(0).toUpperCase();

    const review = await prisma.review.create({
      data: {
        userId: user.id,
        name: displayName,
        initial,
        text: content,
        rating: 5,
        image: imageUrl,
        time: "Vừa xong",
        status: "pending",
        isApproved: false,
        isFeatured: false,
      },
    });

    return NextResponse.json({
      success: true,
      message: "Đã gửi đánh giá. Admin sẽ duyệt và hiển thị trên trang chủ.",
      review,
    });
  } catch (err) {
    console.error("[REVIEW POST ERROR]", err);
    return NextResponse.json(
      { success: false, error: "Lỗi server, vui lòng thử lại" },
      { status: 500 }
    );
  }
}

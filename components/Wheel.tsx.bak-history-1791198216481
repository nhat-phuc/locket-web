"use client";

import { useEffect, useRef, useState } from "react";
import { useRouter } from "next/navigation";
import Footer from "@/components/Footer";
import { MAX_SPINS_PER_DAY, WHEEL_ITEMS, type SpinHistory } from "@/lib/wheel";


export default function Wheel() {
  const router = useRouter();
  const wheelRef = useRef<HTMLDivElement>(null);
  const [user, setUser] = useState<{ username: string; email: string; balance?: number; bonusBalance?: number } | null>(null);
  const [spinning, setSpinning] = useState(false);
  const [rotation, setRotation] = useState(0);
  const [spinsLeft, setSpinsLeft] = useState(MAX_SPINS_PER_DAY);
  const [result, setResult] = useState<string | null>(null);
  const [resultType, setResultType] = useState<"success" | "error" | null>(null);
  const [history, setHistory] = useState<SpinHistory[]>([]);

  useEffect(() => {
    const stored = sessionStorage.getItem("locket_user");
    if (!stored) {
      router.push("/dang-nhap");
      return;
    }
    try {
      const u = JSON.parse(stored);
      setUser(u);
      const data = getSpinData();
      setSpinsLeft(Math.max(0, MAX_SPINS_PER_DAY - (data.spins || 0)));
      setHistory(getHistory());

      // Load số dư mới nhất từ API
      fetch("/api/auth/me", { credentials: "include" })
        .then((r) => r.json())
        .then((d) => {
          if (d.success && d.user) {
            setUser({
              username: d.user.username || u.username,
              email: d.user.email || u.email,
              balance: d.user.balance || 0,
              bonusBalance: d.user.bonusBalance || 0,
            });
          }
        })
        .catch(() => {});
    } catch {}
  }, [router]);

  const handleSpin = async () => {
    if (spinning || spinsLeft <= 0 || !user) return;

    setSpinning(true);
    setResult(null);
    setResultType(null);

    const item = pickRandomItem();
    const newRotation = getTargetRotation(item.id, rotation);
    setRotation(newRotation);

    if (wheelRef.current) {
      wheelRef.current.style.transition = "transform 5s cubic-bezier(0.17, 0.67, 0.16, 1)";
      wheelRef.current.style.transform = `rotate(${newRotation}deg)`;
    }

    setTimeout(async () => {
      try {
        const controller = new AbortController();
        const timeoutId = setTimeout(() => controller.abort(), 10000);
        const res = await fetch("/api/spin", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          credentials: "include",
          body: JSON.stringify({ label: item.label, value: item.value, type: item.type }),
          signal: controller.signal,
        });
        clearTimeout(timeoutId);
        const data = await res.json();
        if (data.success) {
          setResult(data.message);
          setResultType(item.value > 0 ? "success" : "error");
          setSpinsLeft(data.spinsLeft ?? Math.max(0, spinsLeft - 1));
          setUser((prev) => prev ? { ...prev, balance: data.balance, bonusBalance: data.bonusBalance } : prev);

          const historyItem: SpinHistory = {
            id: Date.now().toString(),
            label: item.label,
            value: item.value,
            type: item.type,
            date: new Date().toISOString(),
          };
          setHistory((h) => [historyItem, ...h].slice(0, 50));
        } else {
          setResult(data.message || "Lỗi");
          setResultType("error");
          setSpinsLeft(data.spinsLeft ?? spinsLeft);
        }
      } catch (err) {
        console.error("Spin error:", err);
        setResult("Lỗi kết nối, vui lòng thử lại");
        setResultType("error");
      } finally {
        setSpinning(false);
      }
    }, 5100);
  };

  if (!user) return null;

  const sliceAngle = 360 / WHEEL_ITEMS.length;

  return (
    <>
      
      <main className="wrap center-y" style={{ paddingTop: 40, paddingBottom: 60 }}>
        <div style={{ width: "100%", maxWidth: 900 }}>
          <div style={{ textAlign: "center", marginBottom: 40 }}>
            <h1
              style={{
                fontSize: 36,
                fontWeight: 900,
                marginBottom: 12,
                background: "linear-gradient(135deg, #fbbf24, #f472b6)",
                WebkitBackgroundClip: "text",
                backgroundClip: "text",
                WebkitTextFillColor: "transparent",
              }}
            >
              🎡 Vòng Quay May Mắn
            </h1>
            <p style={{ color: "var(--text-2)", fontSize: 15 }}>
              Quay miễn phí mỗi ngày — Nhận tiền mặt & voucher hấp dẫn
            </p>
          </div>

          <div
            style={{
              display: "flex",
              justifyContent: "center",
              alignItems: "center",
              gap: 16,
              marginBottom: 24,
              flexWrap: "wrap",
            }}
          >
            <div
              style={{
                padding: "12px 24px",
                borderRadius: 999,
                background: "rgba(167,139,250,.15)",
                border: "1px solid rgba(167,139,250,.3)",
                color: "var(--accent-bright)",
                fontWeight: 700,
                fontSize: 14,
              }}
            >
              🎯 Lượt còn lại: <strong style={{ fontSize: 18 }}>{spinsLeft}</strong> / {MAX_SPINS_PER_DAY}
            </div>
            <div
              style={{
                padding: "12px 24px",
                borderRadius: 999,
                background: "rgba(52,211,153,.15)",
                border: "1px solid rgba(52,211,153,.3)",
                color: "#34d399",
                fontWeight: 700,
                fontSize: 14,
              }}
            >
              👤 {user.username}
            </div>
          </div>

          {result && (
            <div
              style={{
                padding: 20,
                borderRadius: 16,
                marginBottom: 24,
                textAlign: "center",
                background: resultType === "success" ? "rgba(52,211,153,.15)" : "rgba(251,191,36,.15)",
                border: `1px solid ${resultType === "success" ? "rgba(52,211,153,.4)" : "rgba(251,191,36,.4)"}`,
                fontSize: 16,
                fontWeight: 700,
                color: resultType === "success" ? "#34d399" : "#fbbf24",
              }}
            >
              {result}
            </div>
          )}

          <div
            style={{
              display: "flex",
              justifyContent: "center",
              marginBottom: 24,
              position: "relative",
            }}
          >
            <div
              style={{
                position: "absolute",
                top: -10,
                left: "50%",
                transform: "translateX(-50%)",
                zIndex: 10,
                fontSize: 32,
                filter: "drop-shadow(0 4px 12px rgba(0,0,0,0.5))",
              }}
            >
              👇
            </div>
            <div
              style={{
                position: "relative",
                width: "min(400px, 90vw)",
                height: "min(400px, 90vw)",
              }}
            >
              <div
                ref={wheelRef}
                style={{
                  width: "100%",
                  height: "100%",
                  borderRadius: "50%",
                  border: "8px solid #fbbf24",
                  boxShadow: "0 0 40px rgba(251,191,36,.5), inset 0 0 40px rgba(0,0,0,.3)",
                  position: "relative",
                  overflow: "hidden",
                  background: "#0d0d18",
                }}
              >
                <svg viewBox="0 0 200 200" style={{ width: "100%", height: "100%" }}>
                  {WHEEL_ITEMS.map((item, i) => {
                    const startAngle = i * sliceAngle;
                    const endAngle = (i + 1) * sliceAngle;
                    const startRad = (startAngle - 90) * (Math.PI / 180);
                    const endRad = (endAngle - 90) * (Math.PI / 180);
                    const x1 = 100 + 100 * Math.cos(startRad);
                    const y1 = 100 + 100 * Math.sin(startRad);
                    const x2 = 100 + 100 * Math.cos(endRad);
                    const y2 = 100 + 100 * Math.sin(endRad);
                    const midRad = ((startAngle + endAngle) / 2 - 90) * (Math.PI / 180);
                    const textX = 100 + 65 * Math.cos(midRad);
                    const textY = 100 + 65 * Math.sin(midRad);
                    const textRotation = (startAngle + endAngle) / 2;

                    return (
                      <g key={item.id}>
                        <path
                          d={`M 100 100 L ${x1} ${y1} A 100 100 0 0 1 ${x2} ${y2} Z`}
                          fill={item.color}
                          stroke="#0d0d18"
                          strokeWidth="0.5"
                        />
                        <text
                          x={textX}
                          y={textY}
                          fill="#fff"
                          fontSize="6"
                          fontWeight="800"
                          textAnchor="middle"
                          dominantBaseline="middle"
                          transform={`rotate(${textRotation} ${textX} ${textY})`}
                          style={{ pointerEvents: "none" }}
                        >
                          {item.label}
                        </text>
                      </g>
                    );
                  })}
                  <circle cx="100" cy="100" r="20" fill="#fbbf24" stroke="#0d0d18" strokeWidth="2" />
                  <text
                    x="100"
                    y="100"
                    fill="#0d0d18"
                    fontSize="8"
                    fontWeight="900"
                    textAnchor="middle"
                    dominantBaseline="middle"
                  >
                    SPIN
                  </text>
                </svg>
              </div>
            </div>
          </div>

          <div style={{ textAlign: "center", marginBottom: 40 }}>
            <button
              onClick={handleSpin}
              disabled={spinning || spinsLeft <= 0}
              style={{
                padding: "18px 60px",
                borderRadius: 999,
                fontSize: 18,
                fontWeight: 900,
                border: "none",
                cursor: spinning || spinsLeft <= 0 ? "not-allowed" : "pointer",
                background:
                  spinsLeft <= 0
                    ? "linear-gradient(135deg, #4b5563, #374151)"
                    : "linear-gradient(135deg, #fbbf24, #f472b6)",
                color: "#fff",
                boxShadow: spinsLeft > 0 ? "0 12px 40px rgba(251,191,36,.5)" : "none",
                letterSpacing: 1,
                transition: "all .3s",
                opacity: spinning ? 0.7 : 1,
              }}
            >
              {spinning ? "🎡 Đang quay..." : spinsLeft <= 0 ? "Hết lượt hôm nay" : "🎯 QUAY NGAY"}
            </button>
          </div>

          <div>
            <h2 style={{ fontSize: 20, fontWeight: 800, marginBottom: 16, color: "var(--text-0)" }}>
              📜 Lịch sử quay
            </h2>
            {history.length === 0 ? (
              <div
                style={{
                  padding: 40,
                  textAlign: "center",
                  color: "var(--text-2)",
                  background: "var(--bg-1)",
                  borderRadius: 16,
                  border: "1px dashed var(--border)",
                }}
              >
                Chưa có lượt quay nào
              </div>
            ) : (
              <div style={{ display: "flex", flexDirection: "column", gap: 8 }}>
                {history.slice(0, 20).map((h) => (
                  <div
                    key={h.id}
                    style={{
                      display: "flex",
                      justifyContent: "space-between",
                      alignItems: "center",
                      padding: "12px 16px",
                      background: "var(--bg-1)",
                      border: "1px solid var(--border)",
                      borderRadius: 12,
                      gap: 12,
                    }}
                  >
                    <div>
                      <div style={{ fontWeight: 700, fontSize: 14, color: "var(--text-0)" }}>
                        {h.label}
                      </div>
                      <div style={{ fontSize: 11, color: "var(--text-2)", marginTop: 2 }}>
                        {new Date(h.date).toLocaleString("vi-VN")}
                      </div>
                    </div>
                    {h.value > 0 && (
                      <div style={{ fontSize: 15, fontWeight: 800, color: "#34d399" }}>
                        +{h.value.toLocaleString("vi-VN")}đ
                      </div>
                    )}
                  </div>
                ))}
              </div>
            )}
          </div>
        </div>
      </main>
      <Footer />
    </>
  );
}

"use client";

import { useEffect, useState } from "react";

export default function NoticeModal() {
  const [visible, setVisible] = useState(false);

  useEffect(() => {
    const hideUntil = localStorage.getItem("notice_hidden_until");
    if (!hideUntil || Date.now() > parseInt(hideUntil)) {
      const t = setTimeout(() => setVisible(true), 600);
      return () => clearTimeout(t);
    }
  }, []);

  const close = () => setVisible(false);
  const close24h = () => {
    close();
    localStorage.setItem(
      "notice_hidden_until",
      String(Date.now() + 24 * 60 * 60 * 1000)
    );
  };

  if (!visible) return null;

  return (
    <>
      {/* Overlay — không blur, chỉ làm tối */}
      <div
        onClick={close}
        style={{
          position: "fixed",
          inset: 0,
          background: "rgba(0, 0, 0, 0.4)",
          zIndex: 99998,
          animation: "noticeFadeIn 0.25s ease",
        }}
      />

      {/* Popup — full width ở dưới cùng */}
      <div
        style={{
          position: "fixed",
          left: 0,
          right: 0,
          bottom: 0,
          width: "100%",
          maxWidth: "100%",
          background: "#ffffff",
          borderRadius: "24px 24px 0 0",
          borderTop: "1px solid #e5e7eb",
          boxShadow: "0 -10px 40px rgba(0, 0, 0, 0.3)",
          padding: "24px 20px 28px",
          animation: "noticeSlideUp 0.35s cubic-bezier(0.34, 1.2, 0.64, 1)",
          boxSizing: "border-box",
          maxHeight: "85vh",
          overflowY: "auto",
          zIndex: 99999,
        }}
      >
        {/* Close button */}
        <button
          onClick={close}
          aria-label="Đóng"
          style={{
            position: "absolute",
            top: 14,
            right: 14,
            width: 28,
            height: 28,
            borderRadius: "50%",
            background: "transparent",
            border: "none",
            color: "#9ca3af",
            cursor: "pointer",
            display: "flex",
            alignItems: "center",
            justifyContent: "center",
          }}
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2">
            <line x1="18" y1="6" x2="6" y2="18" />
            <line x1="6" y1="6" x2="18" y2="18" />
          </svg>
        </button>

        <h2
          style={{
            fontSize: 22,
            fontWeight: 800,
            color: "#0e7490",
            textAlign: "center",
            margin: "0 0 18px",
            letterSpacing: "-0.3px",
          }}
        >
          Thông Báo
        </h2>

        {/* Card nội dung */}
        <div
          style={{
            display: "flex",
            gap: 12,
            alignItems: "flex-start",
            padding: 14,
            borderRadius: 14,
            background: "linear-gradient(135deg, #fce7f3 0%, #f3e8ff 100%)",
            border: "1px solid #fbcfe8",
            marginBottom: 18,
            maxWidth: 720,
            marginLeft: "auto",
            marginRight: "auto",
          }}
        >
          <div
            style={{
              width: 40,
              height: 40,
              flexShrink: 0,
              borderRadius: "50%",
              background: "linear-gradient(135deg, #ec4899, #a855f7)",
              color: "#fff",
              display: "flex",
              alignItems: "center",
              justifyContent: "center",
              fontSize: 20,
              boxShadow: "0 4px 12px rgba(236, 72, 153, 0.35)",
            }}
          >
            ⭐
          </div>
          <div style={{ flex: 1, minWidth: 0 }}>
            <div
              style={{
                fontSize: 14.5,
                fontWeight: 800,
                color: "#111827",
                lineHeight: 1.4,
                marginBottom: 6,
              }}
            >
              🎉 Chính thức ra mắt gói Siêu VIP (SVIP) Độc Quyền!
            </div>
            <div
              style={{
                fontSize: 13.5,
                color: "#4b5563",
                lineHeight: 1.55,
              }}
            >
              Trải nghiệm quyền lực tối thượng với gói SVIP: Chỉ cần Username,
              Không cần Nhập DNS. Nâng cấp mượt mà, an toàn tuyệt đối và tự
              động lên Gold trong 1 nốt nhạc!
            </div>
          </div>
        </div>

        {/* 2 nút */}
        <div
          style={{
            display: "flex",
            gap: 12,
            maxWidth: 720,
            marginLeft: "auto",
            marginRight: "auto",
          }}
        >
          <button
            onClick={close}
            style={{
              flex: 1,
              padding: "13px",
              borderRadius: 12,
              border: "none",
              background: "#22d3ee",
              color: "#0e1414",
              fontSize: 14.5,
              fontWeight: 700,
              cursor: "pointer",
              fontFamily: "inherit",
              boxShadow: "0 4px 14px rgba(34, 211, 238, 0.35)",
            }}
          >
            Đã hiểu
          </button>
          <button
            onClick={close24h}
            style={{
              flex: 1,
              padding: "13px",
              borderRadius: 12,
              border: "1.5px solid #fbcfe8",
              background: "#fff1f2",
              color: "#ef4444",
              fontSize: 14.5,
              fontWeight: 700,
              cursor: "pointer",
              fontFamily: "inherit",
            }}
          >
            Đóng trong 24h tới
          </button>
        </div>
      </div>

      <style jsx global>{`
        @keyframes noticeFadeIn {
          from { opacity: 0; }
          to { opacity: 1; }
        }
        @keyframes noticeSlideUp {
          from { transform: translateY(100%); }
          to { transform: translateY(0); }
        }
      `}</style>
    </>
  );
}

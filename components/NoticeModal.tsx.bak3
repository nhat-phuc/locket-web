"use client";

import { useEffect, useState } from "react";

export default function NoticeModal() {
  const [visible, setVisible] = useState(false);

  useEffect(() => {
    const hideUntil = localStorage.getItem("notice_hidden_until");
    if (!hideUntil || Date.now() > parseInt(hideUntil)) {
      const t = setTimeout(() => setVisible(true), 600);
      return () => clearTimeout(t);
    }
  }, []);

  const close = () => setVisible(false);
  const close24h = () => {
    close();
    localStorage.setItem(
      "notice_hidden_until",
      String(Date.now() + 24 * 60 * 60 * 1000)
    );
  };

  if (!visible) return null;

  return (
    <div className="admin-modal show" style={{ zIndex: 99999 }}>
      <div className="notice-modal-box">
        <div className="notice-glow" />

        <button onClick={close} className="notice-close-btn" aria-label="Đóng">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2">
            <line x1="18" y1="6" x2="6" y2="18" />
            <line x1="6" y1="6" x2="18" y2="18" />
          </svg>
        </button>

        <div className="notice-content">
          <h2 className="notice-title">Thông Báo</h2>

          <div className="notice-body">
            <div className="notice-card notice-card-gold">
              <p className="notice-welcome">🚀 CHÀO MỪNG BẠN ĐẾN VỚI LOCKET GOLD 🚀</p>

              <div className="notice-subcard notice-subcard-red">
                <p className="notice-subtitle notice-subtitle-red">
                  💎 NÂNG CẤP TỰ ĐỘNG 5S - AN TOÀN TUYỆT ĐỐI
                </p>
                <p className="notice-line">
                  ✅ <strong>Không cần Pass/iCloud</strong> - Chỉ cần duy nhất Username.
                </p>
                <p className="notice-line">
                  ✅ Hệ thống Auto từ A-Z, lên Gold cực mượt không cần chờ đợi.
                </p>
                <p className="notice-line notice-line-small">
                  <i>*🎁 Đặc biệt: Chốt đơn là TẶNG NGAY Canva Edu 3 Năm</i>
                </p>
              </div>

              <div className="notice-subcard notice-subcard-orange">
                <p className="notice-subtitle notice-subtitle-orange">
                  🎰 VÒNG QUAY NHÂN PHẨM
                </p>
                <p className="notice-line">
                  Làm nhiệm vụ mỗi ngày nhận lượt quay FREE.
                </p>
                <p className="notice-line">
                  Cơ hội trúng ngay <strong>Tiền mặt</strong> hoặc Voucher <strong>FREE 100%</strong>.
                </p>
              </div>

              <div className="notice-actions-row">
                <a href="https://zalo.me/0344421026" className="notice-btn notice-btn-zalo">
                  💬 BOX ZALO HỖ TRỢ
                </a>
                <a href="/vong-quay" className="notice-btn notice-btn-spin">
                  🎡 QUAY NGAY
                </a>
              </div>
            </div>
          </div>

          <div className="notice-footer-row">
            <button onClick={close} className="notice-footer-btn notice-footer-primary">
              Đã hiểu
            </button>
            <button onClick={close24h} className="notice-footer-btn notice-footer-danger">
              Đóng trong 24h tới
            </button>
          </div>
        </div>
      </div>

      <style jsx>{`
        .notice-modal-box {
          width: 100%;
          max-width: 420px;              /* 👈 Thu nhỏ từ 520 → 420 */
          max-height: 90vh;
          overflow-y: auto;
          padding: 22px 18px;            /* 👈 Giảm từ 32×24 → 22×18 */
          border-radius: 20px;
          background: linear-gradient(145deg, var(--bg-1), var(--bg-0));
          border: 1px solid var(--border-accent);
          box-shadow: 0 20px 60px rgba(0, 0, 0, 0.6);
          text-align: center;
          position: relative;
        }

        .notice-glow {
          position: absolute;
          top: -20px;
          left: -20px;
          right: -20px;
          height: 100px;
          background: linear-gradient(135deg, #64d5f2, transparent);
          opacity: 0.15;
          z-index: 0;
          filter: blur(20px);
          pointer-events: none;
        }

        .notice-close-btn {
          position: absolute;
          top: 12px;
          right: 12px;
          background: rgba(255, 255, 255, 0.06);
          border-radius: 50%;
          width: 30px;
          height: 30px;
          display: flex;
          align-items: center;
          justify-content: center;
          border: 1px solid rgba(255, 255, 255, 0.1);
          color: var(--text-2);
          cursor: pointer;
          z-index: 10;
        }

        .notice-content {
          position: relative;
          z-index: 1;
        }

        .notice-title {
          font-size: 20px;              /* 👈 Giảm từ 24 → 20 */
          font-weight: 800;
          margin: 0 0 10px 0;
          letter-spacing: -0.5px;
          background: linear-gradient(90deg, var(--accent-bright), #64d5f2);
          -webkit-background-clip: text;
          background-clip: text;
          -webkit-text-fill-color: transparent;
        }

        .notice-body {
          font-size: 14px;
          line-height: 1.6;
          color: var(--text-2);
          margin-bottom: 14px;
          text-align: left;
          word-wrap: break-word;
        }

        .notice-card {
          text-align: center;
          border: 2px solid #f1c40f;
          padding: 12px;                /* 👈 Giảm từ 15 → 12 */
          border-radius: 10px;
          background: linear-gradient(135deg, #fffcf0 0%, #ffffff 100%);
          margin: 0 auto;
          box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
          font-family: Arial, sans-serif;
        }

        .notice-welcome {
          margin: 0 0 10px 0;
          font-size: 15px;              /* 👈 Giảm từ 18 → 15 */
          color: #e74c3c;
          font-weight: bold;
          line-height: 1.4;
        }

        .notice-subcard {
          border-radius: 6px;
          padding: 8px;                 /* 👈 Giảm từ 10 → 8 */
          margin-bottom: 8px;
        }
        .notice-subcard-red {
          background-color: #fff9f9;
          border: 1px dashed #e74c3c;
        }
        .notice-subcard-orange {
          background-color: #ffffff;
          border: 1px dashed #e67e22;
        }

        .notice-subtitle {
          margin: 0 0 4px 0;
          font-size: 13px;              /* 👈 Giảm từ 14 → 13 */
          font-weight: bold;
        }
        .notice-subtitle-red { color: #e74c3c; }
        .notice-subtitle-orange { color: #d35400; }

        .notice-line {
          margin: 2px 0;
          font-size: 12px;              /* 👈 Giảm từ 13 → 12 */
          color: #333;
          line-height: 1.5;
        }
        .notice-line-small {
          font-size: 11px;              /* 👈 Giảm từ 12 → 11 */
          color: #d35400;
        }

        .notice-actions-row {
          display: flex;
          justify-content: space-between;
          gap: 8px;
          margin-top: 8px;
        }

        .notice-btn {
          flex: 1;
          color: #ffffff;
          padding: 9px 10px;            /* 👈 Giảm từ 10×12 → 9×10 */
          border-radius: 6px;
          text-decoration: none;
          font-weight: bold;
          font-size: 12.5px;            /* 👈 Giảm từ 13.5 → 12.5 */
          box-shadow: 0 2px 5px rgba(0, 0, 0, 0.2);
          text-align: center;
          display: flex;
          align-items: center;
          justify-content: center;
        }
        .notice-btn-zalo { background-color: #0088cc; }
        .notice-btn-spin { background-color: #f39c12; }

        .notice-footer-row {
          display: flex;
          gap: 8px;
        }

        .notice-footer-btn {
          flex: 1;
          display: flex;
          align-items: center;
          justify-content: center;
          padding: 11px;                /* 👈 Giảm từ 14 → 11 */
          border-radius: 12px;
          font-size: 13.5px;            /* 👈 Giảm từ 15 → 13.5 */
          cursor: pointer;
        }
        .notice-footer-primary {
          font-weight: 700;
          border: none;
          background: #64d5f2;
          color: #111313;
          box-shadow: 0 8px 24px rgba(0, 0, 0, 0.25);
        }
        .notice-footer-danger {
          font-weight: 600;
          border: 1px solid rgba(248, 113, 113, 0.3);
          background: rgba(239, 68, 68, 0.1);
          color: var(--red);
        }

        /* ═══ MOBILE ═══ */
        @media (max-width: 640px) {
          .notice-modal-box {
            padding: 18px 14px;
            border-radius: 18px;
            max-width: calc(100vw - 24px);
            max-height: 92vh;
          }

          .notice-title { font-size: 18px; }
          .notice-welcome { font-size: 14px; }
          .notice-subtitle { font-size: 12.5px; }
          .notice-line { font-size: 11.5px; }
          .notice-line-small { font-size: 11px; }

          .notice-actions-row {
            flex-direction: column;
            gap: 6px;
          }
          .notice-btn {
            width: 100%;
            padding: 10px;
            font-size: 12.5px;
          }

          .notice-footer-row {
            flex-direction: column;
            gap: 6px;
          }
          .notice-footer-btn {
            width: 100%;
            font-size: 13px;
            padding: 11px;
          }
        }

        @media (max-width: 400px) {
          .notice-modal-box { padding: 14px 10px; }
          .notice-title { font-size: 16px; }
          .notice-welcome { font-size: 13px; }
          .notice-subtitle { font-size: 12px; }
          .notice-line { font-size: 11px; }
        }
      `}</style>
    </div>
  );
}

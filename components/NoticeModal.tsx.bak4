"use client";

import { useEffect, useState } from "react";

export default function NoticeModal() {
  const [visible, setVisible] = useState(false);

  useEffect(() => {
    const hideUntil = localStorage.getItem("notice_hidden_until");
    if (!hideUntil || Date.now() > parseInt(hideUntil)) {
      const t = setTimeout(() => setVisible(true), 600);
      return () => clearTimeout(t);
    }
  }, []);

  const close = () => setVisible(false);
  const close24h = () => {
    close();
    localStorage.setItem(
      "notice_hidden_until",
      String(Date.now() + 24 * 60 * 60 * 1000)
    );
  };

  if (!visible) return null;

  return (
    <div className="admin-modal show" style={{ zIndex: 99999 }}>
      <div className="notice-modal-box">
        {/* Close button */}
        <button onClick={close} className="notice-close-btn" aria-label="Đóng">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2">
            <line x1="18" y1="6" x2="6" y2="18" />
            <line x1="6" y1="6" x2="18" y2="18" />
          </svg>
        </button>

        {/* Title */}
        <h2 className="notice-title">Thông Báo</h2>

        {/* Card nội dung */}
        <div className="notice-card">
          <div className="notice-card-icon">⭐</div>
          <div className="notice-card-text">
            <div className="notice-card-heading">
              🎉 Chính thức ra mắt gói Siêu VIP (SVIP) Độc Quyền!
            </div>
            <div className="notice-card-desc">
              Trải nghiệm quyền lực tối thượng với gói SVIP: Chỉ cần Username,
              Không cần Nhập DNS. Nâng cấp mượt mà, an toàn tuyệt đối và tự
              động lên Gold trong 1 nốt nhạc!
            </div>
          </div>
        </div>

        {/* 2 nút ngang */}
        <div className="notice-footer-row">
          <button onClick={close} className="notice-footer-btn notice-footer-primary">
            Đã hiểu
          </button>
          <button onClick={close24h} className="notice-footer-btn notice-footer-danger">
            Đóng trong 24h tới
          </button>
        </div>
      </div>

      <style jsx>{`
        .notice-modal-box {
          width: 100%;
          max-width: 440px;
          max-height: 90vh;
          overflow-y: auto;
          padding: 24px 22px 22px;
          border-radius: 20px;
          background: #ffffff;
          border: 1px solid var(--border-accent, #e5e7eb);
          box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
          text-align: center;
          position: relative;
        }

        .notice-close-btn {
          position: absolute;
          top: 14px;
          right: 14px;
          background: transparent;
          border-radius: 50%;
          width: 28px;
          height: 28px;
          display: flex;
          align-items: center;
          justify-content: center;
          border: none;
          color: #9ca3af;
          cursor: pointer;
          transition: all 0.2s;
        }
        .notice-close-btn:hover {
          background: rgba(0, 0, 0, 0.05);
          color: #111;
        }

        .notice-title {
          font-size: 22px;
          font-weight: 800;
          margin: 0 0 18px 0;
          color: #0e7490;
          letter-spacing: -0.3px;
        }

        /* Card nội dung */
        .notice-card {
          display: flex;
          gap: 12px;
          align-items: flex-start;
          padding: 14px;
          border-radius: 14px;
          background: linear-gradient(135deg, #fce7f3 0%, #f3e8ff 100%);
          border: 1px solid #fbcfe8;
          text-align: left;
          margin-bottom: 18px;
        }

        .notice-card-icon {
          width: 40px;
          height: 40px;
          flex-shrink: 0;
          border-radius: 50%;
          background: linear-gradient(135deg, #ec4899, #a855f7);
          color: #fff;
          display: flex;
          align-items: center;
          justify-content: center;
          font-size: 20px;
          box-shadow: 0 4px 12px rgba(236, 72, 153, 0.35);
        }

        .notice-card-text {
          flex: 1;
          min-width: 0;
        }

        .notice-card-heading {
          font-size: 14.5px;
          font-weight: 800;
          color: #111827;
          line-height: 1.4;
          margin-bottom: 6px;
        }

        .notice-card-desc {
          font-size: 13.5px;
          color: #4b5563;
          line-height: 1.55;
        }

        /* 2 nút ngang */
        .notice-footer-row {
          display: flex;
          gap: 12px;
        }

        .notice-footer-btn {
          flex: 1;
          display: flex;
          align-items: center;
          justify-content: center;
          padding: 12px 14px;
          border-radius: 12px;
          font-size: 14px;
          font-weight: 700;
          cursor: pointer;
          transition: all 0.2s;
          font-family: inherit;
        }
        .notice-footer-primary {
          border: none;
          background: #22d3ee;
          color: #0e1414;
          box-shadow: 0 4px 14px rgba(34, 211, 238, 0.35);
        }
        .notice-footer-primary:hover {
          background: #06b6d4;
          transform: translateY(-1px);
        }
        .notice-footer-danger {
          border: 1.5px solid #fbcfe8;
          background: #fff1f2;
          color: #ef4444;
        }
        .notice-footer-danger:hover {
          background: #fee2e2;
          transform: translateY(-1px);
        }

        /* ═══ MOBILE ═══ */
        @media (max-width: 480px) {
          .notice-modal-box {
            padding: 20px 16px 18px;
            border-radius: 18px;
            max-width: calc(100vw - 24px);
          }
          .notice-title { font-size: 19px; margin-bottom: 14px; }
          .notice-card { padding: 12px; gap: 10px; }
          .notice-card-icon { width: 36px; height: 36px; font-size: 18px; }
          .notice-card-heading { font-size: 13.5px; }
          .notice-card-desc { font-size: 12.5px; }
          .notice-footer-btn { font-size: 13px; padding: 11px 10px; }
        }

        @media (max-width: 360px) {
          .notice-footer-row { flex-direction: column; gap: 8px; }
        }
      `}</style>
    </div>
  );
}

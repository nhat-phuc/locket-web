# ─── CALLBACK HANDLER ───
async def cb_router(update: Update, ctx: ContextTypes.DEFAULT_TYPE):
    q = update.callback_query
    await q.answer()
    data = q.data
    tg_id = str(q.from_user.id)

    # Nút menu
    if data == "menu":
        await q.edit_message_text("🏠 Menu chính", reply_markup=main_menu())
        return

    if data == "help":
        await q.edit_message_text(
            "<b>📖 HƯỚNG DẪN</b>\n\n"
            "/start — Menu chính\n"
            "/sodu — Xem số dư\n"
            "/donhang — Đơn hàng\n"
            "/naptien — Nạp tiền\n"
            "/vongquay — Quay\n"
            "/taikhoan — Tài khoản",
            parse_mode="HTML",
            reply_markup=back_menu(),
        )
        return

    if data == "sodu":
        u = await _get_linked_user(tg_id)
        if not u:
            await q.edit_message_text("❌ Chưa liên kết. Gõ /start.")
            return
        c2, b = await api.get_balance(u["email"])
        if c2 != 200 or not b.get("success"):
            await q.edit_message_text("❌ Không lấy được số dư.")
            return
        text = (
            f"💰 <b>SỐ DƯ CỦA BẠN</b>\n\n"
            f"👛 Ví chính: <b>{fmt(b.get('balance', 0))}</b>\n"
            f"🎁 Ví vòng quay: <b>{fmt(b.get('bonusBalance', 0))}</b>\n"
            f"━━━━━━━━━━━━━━━\n"
            f"💎 Tổng: <b>{fmt(b.get('total', 0))}</b>"
        )
        await q.edit_message_text(text, parse_mode="HTML", reply_markup=back_menu())
        return

    if data == "donhang":
        code, d = await api.get_orders(tg_id)
        if code != 200 or not d.get("success"):
            await q.edit_message_text("❌ Không lấy được đơn hàng.", reply_markup=back_menu())
            return
        orders = d.get("orders", [])[:5]
        if not orders:
            await q.edit_message_text("📭 Bạn chưa có đơn hàng nào.", reply_markup=back_menu())
            return
        lines = ["📦 <b>ĐƠN HÀNG GẦN ĐÂY</b>\n"]
        for o in orders:
            status_emoji = {
                "pending": "⏳", "paid": "✅", "completed": "🎉",
                "cancelled": "❌", "expired": "⏰"
            }.get(o.get("status", ""), "•")
            lines.append(
                f"{status_emoji} <code>{o.get('orderCode')}</code>\n"
                f"   {o.get('serviceName')} — <b>{fmt(o.get('finalAmount', 0))}</b>"
            )
        await q.edit_message_text("\n\n".join(lines), parse_mode="HTML", reply_markup=back_menu())
        return

    if data == "naptien":
        await q.edit_message_text(
            "💳 <b>NẠP TIỀN</b>\n\n"
            "Chọn số tiền bên dưới:",
            parse_mode="HTML",
            reply_markup=amount_menu(),
        )
        ctx.user_data["awaiting"] = "amount"
        return

    if data == "vongquay":
        await q.edit_message_text(
            f"🎡 <b>VÒNG QUAY MAY MẮN</b>\n\n"
            f"👉 Mở web: {WEB_URL}/vong-quay\n\n"
            f"Bạn có 3 lượt/ngày.",
            parse_mode="HTML",
            reply_markup=back_menu(),
        )
        return

    if data == "taikhoan":
        u = await _get_linked_user(tg_id)
        if not u:
            await q.edit_message_text("❌ Chưa liên kết. Gõ /start.")
            return
        text = (
            f"👤 <b>TÀI KHOẢN</b>\n\n"
            f"Username: <code>@{u.get('username')}</code>\n"
            f"Email: {u.get('email')}\n"
            f"Vai trò: <b>{u.get('role', 'user').upper()}</b>\n"
            f"Tổng đơn: {u.get('totalOrders', 0)}\n"
            f"Đã thanh toán: {u.get('paidOrders', 0)}"
        )
        await q.edit_message_text(text, parse_mode="HTML", reply_markup=back_menu())
        return

    # Chọn số tiền nạp
    if data.startswith("amount_"):
        amount = int(data.replace("amount_", ""))
        await _create_recharge(q, tg_id, amount)
        return

    # Copy mã đơn
    if data.startswith("copy_"):
        order_code = data.replace("copy_", "")
        await q.answer(f"Mã đơn: {order_code}", show_alert=True)
        return


async def _create_recharge(q, tg_id: str, amount: int):
    """Tạo đơn nạp + hiện QR"""
    code, d = await api.create_recharge(tg_id, amount)
    if code != 200 or not d.get("success"):
        await q.edit_message_text(
            f"❌ {d.get('message', 'Lỗi tạo đơn')}",
            reply_markup=back_menu(),
        )
        return

    qr_url = d.get("qrUrl", "")
    order_code = d.get("orderCode", "")
    bank = d.get("bank", "")
    acc = d.get("accountNumber", "")
    name = d.get("accountName", "")

    text = (
        f"✅ <b>ĐÃ TẠO ĐƠN NẠP</b>\n\n"
        f"💰 Số tiền: <b>{fmt(amount)}</b>\n"
        f"📋 Mã đơn: <code>{order_code}</code>\n"
        f"━━━━━━━━━━━━━━━\n"
        f"🏦 Ngân hàng: <b>{bank}</b>\n"
        f"💳 Số TK: <code>{acc}</code>\n"
        f"👤 Chủ TK: {name}\n\n"
        f"⚠️ <b>Nội dung CK bắt buộc:</b> <code>{order_code}</code>\n\n"
        f"⏱ Đơn hết hạn sau 15 phút."
    )
    await q.edit_message_text(
        text,
        parse_mode="HTML",
        reply_markup=qr_menu(qr_url, order_code) if qr_url else back_menu(),
    )


# ─── TEXT HANDLER ───
async def handle_text(update: Update, ctx: ContextTypes.DEFAULT_TYPE):
    """Xử lý khi user gõ số tiền"""
    if ctx.user_data.get("awaiting") != "amount":
        await update.message.reply_text("Gõ /start để mở menu.")
        return

    text = update.message.text.strip().replace(".", "").replace(",", "")
    if not text.isdigit():
        await update.message.reply_text("❌ Vui lòng nhập số. Ví dụ: 50000")
        return

    amount = int(text)
    if amount < 10000:
        await update.message.reply_text("❌ Tối thiểu 10.000đ")
        return

    tg_id = str(update.effective_user.id)
    code, d = await api.create_recharge(tg_id, amount)

    if code != 200 or not d.get("success"):
        await update.message.reply_html(
            f"❌ {d.get('message', 'Lỗi tạo đơn')}",
            reply_markup=main_menu(),
        )
        ctx.user_data["awaiting"] = None
        return

    qr_url = d.get("qrUrl", "")
    order_code = d.get("orderCode", "")
    bank = d.get("bank", "")
    acc = d.get("accountNumber", "")
    name = d.get("accountName", "")

    msg = (
        f"✅ <b>ĐÃ TẠO ĐƠN NẠP</b>\n\n"
        f"�� Số tiền: <b>{fmt(amount)}</b>\n"
        f"📋 Mã đơn: <code>{order_code}</code>\n"
        f"━━━━━━━━━━━━━━━\n"
        f"🏦 {bank} — <code>{acc}</code>\n"
        f"👤 {name}\n\n"
        f"⚠️ Nội dung CK: <code>{order_code}</code>"
    )
    await update.message.reply_html(
        msg,
        reply_markup=qr_menu(qr_url, order_code) if qr_url else main_menu(),
    )
    ctx.user_data["awaiting"] = None
